---
/**
 * src/pages/roadmap/[slug].astro — validated, secure static routing
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import RoadmapCanvas from '../../components/RoadmapCanvas';
import BookmarkToggle from '../../components/BookmarkToggle';
import { RoadmapSchema, TopicSchema, SlugSchema, type Roadmap, type Topic } from '../../lib/security';

export async function getStaticPaths() {
  const mods = import.meta.glob('../../content/roadmaps/*.json', { eager: true });
  return Object.values(mods)
    .map((m: any) => { const r = RoadmapSchema.safeParse(m.default ?? m); return r.success ? { params: { slug: r.data.id } } : null; })
    .filter(Boolean);
}

const { slug } = Astro.params;
const slugResult = SlugSchema.safeParse(slug);
if (!slugResult.success) return Astro.redirect('/404');
const safeSlug = slugResult.data;

const roadmapMods = import.meta.glob('../../content/roadmaps/*.json', { eager: true });
let roadmap: Roadmap | null = null;
for (const m of Object.values(roadmapMods)) {
  const r = RoadmapSchema.safeParse((m as any).default ?? m);
  if (r.success && r.data.id === safeSlug) { roadmap = r.data; break; }
}
if (!roadmap) return Astro.redirect('/404');

const topicMods = import.meta.glob('../../content/topics/*.json', { eager: true });
const topicMap = new Map<string, Topic>();
for (const [, m] of Object.entries(topicMods)) {
  const r = TopicSchema.safeParse((m as any).default ?? m);
  if (r.success) topicMap.set(r.data.id, r.data);
}

const topicContents = roadmap.nodes.map((node) => {
  const t = topicMap.get(node.id);
  return { nodeId: node.id, markdownBody: t?.body ?? '', resources: t?.resources ?? [] };
});
---

<BaseLayout title={`${roadmap.title} — Cosmic`} description={roadmap.description}>
  <style>
    * { box-sizing: border-box; }
    html, body { height: 100%; margin: 0; }
    .page { display: flex; flex-direction: column; height: 100dvh; background: #0D0D0D; }
    /* The canvas is a flex child; without an explicit flex basis the 100% canvas
       inside RoadmapCanvas collapses to zero height on the deployed route. */
    .canvas-wrap { flex: 1 1 auto; min-height: 0; position: relative; overflow: hidden; }

    /* ── Top Bar ── */
    .topbar {
      flex-shrink: 0;
      display: flex; align-items: center; justify-content: space-between;
      height: 56px; padding: 0 20px;
      background: rgba(13,13,13,0.95);
      border-bottom: 1px solid #1f1f1f;
      backdrop-filter: blur(10px);
      position: relative; z-index: 10;
    }
    .topbar-left { display: flex; align-items: center; gap: 16px; }
    .back-link {
      display: flex; align-items: center; gap: 6px;
      font-size: 0.78rem; font-weight: 500; color: #525252;
      text-decoration: none; padding: 5px 8px;
      border-radius: 6px; transition: color .15s, background .15s;
    }
    .back-link:hover { color: #A3A3A3; background: #1a1a1a; }
    .topbar-sep { color: #2a2a2a; font-size: 0.9rem; }
    .topbar-title { display: flex; align-items: center; gap: 10px; }
    .topbar-icon { font-size: 1.25rem; line-height: 1; display: inline-flex; align-items: center; justify-content: center; }
    .topbar-name {
      font-size: 0.92rem; font-weight: 700; color: #E5E5E5;
      letter-spacing: -0.02em; white-space: nowrap;
    }
    .topbar-count {
      font-size: 0.72rem; font-weight: 500; color: #525252;
      background: #1a1a1a; border: 1px solid #222; border-radius: 999px;
      padding: 3px 8px; white-space: nowrap; line-height: 1;
    }
    .topbar-right { display: flex; align-items: center; gap: 8px; }
    .topbar-btn {
      height: 28px; padding: 0 10px; border-radius: 6px;
      border: 1px solid #1f1f1f; background: none; color: #737373;
      font-size: 0.72rem; font-weight: 600; font-family: inherit;
      cursor: pointer; display: inline-flex; align-items: center; gap: 6px;
      text-decoration: none; transition: all .15s ease;
    }
    .topbar-btn:hover { color: #A3A3A3; border-color: #2a2a2a; background: #141722; }
    .topbar-btn:focus-visible, .back-link:focus-visible {
      outline: 2px solid #FCD068;
      outline-offset: 2px;
    }
    @media (max-width: 640px) {
      .topbar { height: 52px; padding: 0 10px; }
      .topbar-left { gap: 7px; min-width: 0; }
      .topbar-sep { display: none; }
      .back-link { padding: 4px 2px; font-size: 0.72rem; white-space: nowrap; }
      .topbar-title { gap: 6px; min-width: 0; }
      .topbar-name { max-width: 140px; overflow: hidden; text-overflow: ellipsis; }
      .topbar-count { display: none; }
      .topbar-right { gap: 4px; }
      .topbar-btn { padding: 0 7px; }
      .topbar-right > .topbar-btn:last-child { font-size: 0; }
      .topbar-right > .topbar-btn:last-child svg { width: 14px; height: 14px; }
    }
  </style>

  <div class="page">
    <!-- Top Bar -->
    <header class="topbar" role="banner">
      <div class="topbar-left">
        <a href="/" class="back-link" aria-label="Back to all roadmaps">
          ← All Roadmaps
        </a>
        <span class="topbar-sep" aria-hidden="true">/</span>
        <div class="topbar-title">
          <span class="topbar-icon" role="img" aria-label={`${roadmap.title} icon`}>{roadmap.icon}</span>
          <span class="topbar-name">{roadmap.title}</span>
          <span class="topbar-count">{roadmap.nodes.length} topics</span>
        </div>
      </div>
      <div class="topbar-right">
        <BookmarkToggle client:only="react" roadmapId={roadmap.id} />
        <button id="share-btn" class="topbar-btn" aria-label="Share this roadmap">
          <span id="share-icon" style="font-size: 0.8rem; line-height: 1;">↗</span> Share
        </button>
        <a href="https://github.com/mantisdarling/cosmic" target="_blank" rel="noopener noreferrer" class="topbar-btn" aria-label="GitHub Repository">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
          GitHub
        </a>
      </div>
    </header>

    <!-- AI Tutor Banner -->
    <div style="
      flex-shrink:0;
      padding: 10px 20px;
      background: linear-gradient(90deg, rgba(245,166,35,0.08) 0%, rgba(245,166,35,0.03) 100%);
      border-bottom: 1px solid rgba(245,166,35,0.15);
      display: flex; align-items: center; justify-content: space-between;
      gap: 12px;
    ">
      <div style="display:flex;align-items:center;gap:10px;">
        <span style="
          display:inline-flex;align-items:center;gap:5px;
          background:rgba(245,166,35,0.12);border:1px solid rgba(245,166,35,0.3);
          border-radius:999px;padding:3px 10px;
          font-size:0.68rem;font-weight:700;color:#F5A623;
          font-family:'Space Mono',monospace;letter-spacing:0.05em;
        ">
          <span style="width:6px;height:6px;border-radius:50%;background:#F5A623;display:inline-block;animation:pulse 2s ease-in-out infinite;"></span>
          ✦ AI TUTOR
        </span>
        <span style="font-size:0.8rem;color:#737373;">
          Click any topic node to open it — then switch to <strong style="color:#A3A3A3;">AI Tutor</strong> tab for an instant AI explanation
        </span>
      </div>
      <span style="font-size:0.72rem;color:#2a2a2a;white-space:nowrap;font-family:'Space Mono',monospace;">
        {roadmap.nodes.filter((n: any) => n.type !== 'root').length} topics
      </span>
    </div>
    <style>
      @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.3} }
    </style>

    <!-- Interactive Canvas (React island) -->
    <div class="canvas-wrap">
      <RoadmapCanvas
        roadmap={roadmap}
        topicContents={topicContents}
        client:only="react"
      />
    </div>
  </div>

  <!-- SEO -->
  <div class="sr-only" aria-hidden="true">
    <h1>{roadmap.title}</h1>
    <p>{roadmap.description}</p>
    <ul>{roadmap.nodes.map(n => <li>{n.label}</li>)}</ul>
  </div>

  <!-- Share + Theme script -->
  <script>
    // Share button
    const shareBtn = document.getElementById('share-btn');
    const shareIcon = document.getElementById('share-icon');
    if (shareBtn && shareIcon) {
      shareBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          shareIcon.textContent = '✓';
          shareBtn.style.color = '#22C55E';
          shareBtn.style.borderColor = '#22C55E';
          setTimeout(() => {
            shareIcon.textContent = '↗';
            shareBtn.style.color = '#525252';
            shareBtn.style.borderColor = '#1f1f1f';
          }, 2000);
        } catch {
          window.open(`https://twitter.com/intent/tweet?url=${encodeURIComponent(window.location.href)}`, '_blank');
        }
      });
    }
  </script>
</BaseLayout>
