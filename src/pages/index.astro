---
/**
 * src/pages/index.astro — Landing page
 *
 * Security:
 *  - All roadmap data loaded from local JSON files at build time — no runtime fetch.
 *  - RoadmapSchema validates each JSON file before rendering — malformed data throws at build time.
 *  - SearchBar island receives pre-validated roadmap data — no runtime JSON.parse of user input.
 *  - All user-facing text is from validated schema fields (slugs, titles, etc.)
 *  - No dynamic query param or cookie reading on this page.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import AuthButton from '../components/AuthButton';
import SearchBar from '../components/SearchBar';
import { RoadmapSchema, type Roadmap } from '../lib/security';

// ── Load and validate roadmap data at build time ──────────────────────────
const roadmapModules = import.meta.glob('../content/roadmaps/*.json', { eager: true });

const roadmaps: Roadmap[] = Object.values(roadmapModules)
  .map((mod: any) => {
    const result = RoadmapSchema.safeParse(mod.default ?? mod);
    if (!result.success) {
      console.error('[Build] Invalid roadmap JSON', result.error.flatten());
      return null;
    }
    return result.data;
  })
  .filter((r): r is Roadmap => r !== null);

// Category colors for card accents
const CATEGORY_STYLES: Record<string, { badge: string; dot: string }> = {
  fullstack:  { badge: 'text-indigo-400 bg-indigo-400/10 border-indigo-400/20', dot: '#6366f1' },
  frontend:   { badge: 'text-violet-400 bg-violet-400/10 border-violet-400/20', dot: '#7c3aed' },
  backend:    { badge: 'text-emerald-400 bg-emerald-400/10 border-emerald-400/20', dot: '#10b981' },
  ai:         { badge: 'text-cyan-400 bg-cyan-400/10 border-cyan-400/20', dot: '#06b6d4' },
  devops:     { badge: 'text-amber-400 bg-amber-400/10 border-amber-400/20', dot: '#f59e0b' },
};
---

<BaseLayout
  title="Cosmic — Developer Roadmaps"
  description="Interactive learning roadmaps for Full Stack Web Development, AI Engineering, DevOps, and more. Track your progress, explore topics, and level up your skills."
>
  <Nav />

  <main class="min-h-screen">
    <!-- ── HERO ──────────────────────────────────────────────────────── -->
    <section
      class="relative flex flex-col items-center justify-center pt-40 pb-24 px-6 text-center overflow-hidden"
      aria-labelledby="hero-heading"
    >
      <!-- Background glow -->
      <div
        class="absolute inset-0 pointer-events-none"
        aria-hidden="true"
        style="background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(124,58,237,0.18), transparent)"
      ></div>

      <!-- Badge -->
      <div class="rv mb-6">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-[rgba(124,58,237,0.3)] bg-[rgba(124,58,237,0.08)] font-mono text-xs text-[var(--accent-purple-light)] tracking-widest uppercase">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-purple)] animate-pulse-slow" aria-hidden="true"></span>
          Interactive Roadmaps
        </span>
      </div>

      <!-- Headline -->
      <h1
        id="hero-heading"
        class="rv d1 font-display text-[clamp(3rem,10vw,8rem)] leading-none tracking-wider text-[var(--text-primary)] mb-4"
      >
        YOUR PATH TO
        <br />
        <span style="color: transparent; -webkit-text-stroke: 1px rgba(167,139,250,0.6);">
          MASTERY
        </span>
      </h1>

      <p class="rv d2 font-sans text-lg text-[var(--text-secondary)] max-w-xl mb-10 leading-relaxed">
        Visual, interactive roadmaps for developers. Click any topic to learn what it is,
        why it matters, and how to get started. Sign in to track your progress.
      </p>

      <!-- Search bar island -->
      <div class="rv d3 w-full max-w-md mb-4">
        <SearchBar roadmaps={roadmaps} client:load />
      </div>
      <p class="rv d4 font-mono text-xs text-[var(--text-muted)]">
        Press <kbd class="px-1.5 py-0.5 rounded bg-[var(--bg-tertiary)] border border-[var(--border-default)] text-[var(--text-secondary)]">/</kbd> to search from anywhere
      </p>
    </section>

    <!-- ── MARQUEE STRIP ─────────────────────────────────────────────── -->
    <div class="overflow-hidden border-y border-[var(--border-default)] bg-[var(--bg-secondary)] py-3" aria-hidden="true">
      <div class="flex animate-marquee whitespace-nowrap gap-12" style="width: max-content;">
        {['HTML', 'CSS', 'JavaScript', 'React', 'Node.js', 'TypeScript', 'PostgreSQL', 'Python', 'Docker', 'Git', 'REST APIs', 'GraphQL', 'AI/ML', 'System Design', 'CI/CD', 'Cloud'].map((tech) => (
          <span class="font-mono text-xs text-[var(--text-muted)] tracking-widest uppercase">
            • {tech}
          </span>
        ))}
        {/* Duplicate for seamless loop */}
        {['HTML', 'CSS', 'JavaScript', 'React', 'Node.js', 'TypeScript', 'PostgreSQL', 'Python', 'Docker', 'Git', 'REST APIs', 'GraphQL', 'AI/ML', 'System Design', 'CI/CD', 'Cloud'].map((tech) => (
          <span class="font-mono text-xs text-[var(--text-muted)] tracking-widest uppercase">
            • {tech}
          </span>
        ))}
      </div>
    </div>

    <!-- ── ROADMAP CARDS ─────────────────────────────────────────────── -->
    <section class="px-6 py-20 max-w-7xl mx-auto" aria-labelledby="roadmaps-heading">
      <div class="mb-12">
        <p class="rv font-mono text-xs text-[var(--text-muted)] uppercase tracking-widest mb-2">
          Available Paths
        </p>
        <h2
          id="roadmaps-heading"
          class="rv d1 font-display text-5xl md:text-6xl tracking-wider text-[var(--text-primary)]"
        >
          CHOOSE YOUR PATH
        </h2>
      </div>

      {roadmaps.length === 0 ? (
        <div class="text-center py-20">
          <p class="font-mono text-[var(--text-muted)]">No roadmaps found.</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {roadmaps.map((roadmap, i) => {
            const style = CATEGORY_STYLES[roadmap.id] ?? CATEGORY_STYLES.fullstack;
            const nodeCount = roadmap.nodes.length;
            return (
              <a
                href={`/roadmap/${roadmap.id}`}
                class={`rv d${Math.min(i + 1, 5)} group relative flex flex-col p-6 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-default)] hover:border-[var(--accent-purple)] transition-all duration-300 hover:shadow-glow-sm hover:-translate-y-0.5 no-underline`}
                aria-label={`Open ${roadmap.title} roadmap (${nodeCount} topics)`}
              >
                <!-- Glow on hover -->
                <div
                  class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"
                  style={`background: radial-gradient(ellipse at top left, ${roadmap.color}10, transparent 70%)`}
                  aria-hidden="true"
                ></div>

                <!-- Icon + badge -->
                <div class="flex items-start justify-between mb-4">
                  <span class="text-3xl" role="img" aria-label={`${roadmap.title} icon`}>
                    {roadmap.icon}
                  </span>
                  <span
                    class={`font-mono text-xs px-2 py-1 rounded-full border ${style.badge}`}
                  >
                    {nodeCount} topics
                  </span>
                </div>

                <!-- Title -->
                <h3 class="font-display text-2xl tracking-wider text-[var(--text-primary)] mb-2 group-hover:text-[var(--accent-purple-light)] transition-colors leading-tight">
                  {roadmap.title}
                </h3>

                <!-- Description -->
                <p class="font-sans text-sm text-[var(--text-secondary)] leading-relaxed flex-1 mb-5">
                  {roadmap.description}
                </p>

                <!-- CTA -->
                <div class="flex items-center gap-2 font-mono text-xs text-[var(--text-muted)] group-hover:text-[var(--accent-purple-light)] transition-colors">
                  <span
                    class="w-5 h-px transition-all duration-300 group-hover:w-8"
                    style={`background: ${roadmap.color}`}
                    aria-hidden="true"
                  ></span>
                  View Roadmap ↗
                </div>
              </a>
            );
          })}
        </div>
      )}
    </section>

    <!-- ── FEATURES STRIP ────────────────────────────────────────────── -->
    <section class="border-t border-[var(--border-default)] bg-[var(--bg-secondary)] px-6 py-16" aria-label="Features">
      <div class="max-w-5xl mx-auto grid grid-cols-1 sm:grid-cols-3 gap-8">
        {[
          {
            icon: '◈',
            title: 'INTERACTIVE DIAGRAMS',
            body: 'Pan, zoom, and click nodes to explore any topic in depth.',
          },
          {
            icon: '✓',
            title: 'TRACK PROGRESS',
            body: 'Sign in to mark topics complete and sync across all your devices.',
          },
          {
            icon: '⌕',
            title: 'FUZZY SEARCH',
            body: 'Find any topic instantly across all roadmaps with smart fuzzy search.',
          },
        ].map(({ icon, title, body }) => (
          <div class="rv text-center">
            <span class="font-mono text-3xl text-[var(--accent-purple-light)] block mb-3" aria-hidden="true">{icon}</span>
            <h3 class="font-display text-xl tracking-widest text-[var(--text-primary)] mb-2">{title}</h3>
            <p class="font-sans text-sm text-[var(--text-secondary)] leading-relaxed">{body}</p>
          </div>
        ))}
      </div>
    </section>
  </main>

  <!-- ── FOOTER ──────────────────────────────────────────────────────── -->
  <footer class="border-t border-[var(--border-default)] px-6 py-6 flex items-center justify-between flex-wrap gap-4" role="contentinfo">
    <span class="font-mono text-xs text-[var(--text-muted)]">
      © 2026 Cosmic — Built with Astro + React Flow
    </span>
    <span class="font-mono text-xs text-[var(--text-muted)]">
      Open source · Hosted on Cloudflare Pages
    </span>
  </footer>
</BaseLayout>
