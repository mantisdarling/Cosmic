---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookmarkToggle from '../components/BookmarkToggle';
import { RoadmapSchema, cleanAndParseJSON, type Roadmap } from '../lib/security';

// Load all roadmaps
const modules = import.meta.glob('../content/roadmaps/*.json', { eager: true });
const all: Roadmap[] = Object.values(modules)
  .map((m: any) => { const r = RoadmapSchema.safeParse(m.default ?? m); return r.success ? r.data : null; })
  .filter((r): r is Roadmap => r !== null)
  .sort((a, b) => a.title.localeCompare(b.title));

// Category buckets — updated with new roadmap IDs
const roleIds = [
  'fullstack','frontend','backend','devops','ai-engineer','ml-engineer',
  'android','cybersecurity','data-analyst','blockchain','cloud-engineer',
  'software-architect','qa-engineer','game-dev','react-native',
];
const skillIds = [
  'javascript','typescript','python','react','nodejs','java','go','rust',
  'cpp','csharp','php','ruby','swift','flutter','angular','vue',
  'nextjs-full','django','spring','sql','postgresql','mongodb',
  'graphql','redis','system-design','docker','kubernetes','linux',
  'aws','git','terraform','cicd','html-css','computer-science','api-design',
];

const role  = roleIds.map(id => all.find(r => r.id === id)).filter(Boolean) as Roadmap[];
const skill = skillIds.map(id => all.find(r => r.id === id)).filter(Boolean) as Roadmap[];
const other = all.filter(r => !roleIds.includes(r.id) && !skillIds.includes(r.id));
---

<BaseLayout title="Cosmic — Developer Roadmaps" description="Community created roadmaps, guides and resources to help you grow in your developer career.">

<style>
  /* ── NAV ─────────────────────────────────────────────── */
  .nav {
    position: sticky; top: 0; z-index: 50;
    height: 56px;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 32px;
    background: rgba(11,12,16,0.94);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid #1E2333;
  }
  .nav-left { display: flex; align-items: center; gap: 28px; }
  .nav-logo {
    font-weight: 800; font-size: 1.05rem; letter-spacing: -0.02em;
    color: #F5A623; text-decoration: none;
  }
  .nav-links { display: flex; gap: 2px; }
  .nav-links a {
    padding: 6px 12px; border-radius: 6px;
    font-size: 0.82rem; font-weight: 500; color: #A3A3A3;
    text-decoration: none; transition: color .15s, background .15s;
  }
  .nav-links a:hover { color: #F5F5F5; background: #1f1f1f; }
  .nav-right { display: flex; align-items: center; gap: 10px; }
  .btn-ghost {
    padding: 7px 14px; border-radius: 7px;
    font-size: 0.8rem; font-weight: 500; color: #A3A3A3;
    background: none; border: 1px solid #262626;
    cursor: pointer; transition: all .15s;
    text-decoration: none; display: inline-flex; align-items: center; gap: 6px;
  }
  .btn-ghost:hover { color: #F5F5F5; border-color: #404040; background: #1a1a1a; }
  /* Theme toggle */
  #theme-toggle {
    width: 34px; height: 34px; border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    background: none; border: 1px solid #262626;
    color: #737373; font-size: 1rem; cursor: pointer;
    transition: all .15s;
  }
  #theme-toggle:hover { border-color: #404040; background: #1a1a1a; color: #F5F5F5; }
  @media (max-width: 640px) { .nav-links { display: none; } }

  /* ── HERO CONTAINER ─────────────────────────────────── */
  .hero-container {
    position: relative;
    background-image:
      radial-gradient(circle at 50% 30%, rgba(11,12,16,0.55) 0%, rgba(11,12,16,0.92) 70%, #0B0C10 100%),
      url('/zenitsu-hero.jpg');
    background-size: cover;
    background-position: center 25%;
    border-bottom: 1px solid #1E2333;
  }

  /* ── HERO ─────────────────────────────────────────────── */
  .hero {
    max-width: 780px; margin: 0 auto;
    padding: 72px 24px 48px;
    text-align: center;
  }
  .hero-eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 4px 12px 4px 8px; border-radius: 999px;
    background: rgba(245,166,35,0.1); border: 1px solid rgba(245,166,35,0.25);
    font-size: 0.75rem; font-weight: 500; color: #F5A623;
    margin-bottom: 22px; cursor: default;
  }
  .eyebrow-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: #F5A623; animation: eyebrow-pulse 2s ease-in-out infinite;
  }
  @keyframes eyebrow-pulse { 0%,100% { opacity:1; } 50% { opacity:.35; } }
  .hero h1 {
    font-size: clamp(2.4rem, 6vw, 4rem);
    font-weight: 800; letter-spacing: -0.04em; line-height: 1.1;
    color: #F5F5F5; margin-bottom: 18px;
  }
  .hero h1 span { color: #F5A623; }
  .hero p {
    font-size: 1.05rem; line-height: 1.7; color: #737373;
    max-width: 560px; margin: 0 auto 32px;
  }
  .hero-actions { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-bottom: 40px; }
  .hero-actions a {
    padding: 11px 24px; border-radius: 9px;
    font-size: 0.9rem; font-weight: 600; text-decoration: none;
    transition: all .2s;
  }
  .hero-primary { background: #F5A623; color: #0D0D0D; }
  .hero-primary:hover { background: #FCD068; transform: translateY(-1px); }
  .hero-secondary { background: #1a1a1a; color: #F5F5F5; border: 1px solid #2a2a2a; }
  .hero-secondary:hover { border-color: #404040; background: #222; }

  /* ── SEARCH ──────────────────────────────────────────── */
  .search-wrap {
    max-width: 540px; margin: 0 auto 56px;
    position: relative;
  }
  .search-icon {
    position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
    color: #525252; pointer-events: none; font-size: 1rem;
  }
  #search-input {
    width: 100%; padding: 13px 16px 13px 42px;
    background: #141722; border: 1px solid #1E2333;
    border-radius: 10px; color: #F5F5F5;
    font-size: 0.92rem; font-family: inherit;
    transition: border-color .2s, box-shadow .2s;
    outline: none;
  }
  #search-input::placeholder { color: #404040; }
  #search-input:focus { border-color: rgba(245,166,35,0.5); box-shadow: 0 0 0 3px rgba(245,166,35,0.08); }
  #search-count {
    position: absolute; right: 14px; top: 50%; transform: translateY(-50%);
    font-size: 0.72rem; color: #404040; font-family: 'Space Mono', monospace;
    pointer-events: none;
  }
  #no-results {
    display: none; text-align: center;
    padding: 48px 24px; color: #525252; font-size: 0.9rem;
  }

  /* ── STATS ────────────────────────────────────────────── */
  .stats-bar {
    border-top: 1px solid #1E2333; border-bottom: 1px solid #1E2333;
    background: #0E1017; padding: 20px 32px;
    display: flex; align-items: center; justify-content: center;
    gap: 40px; flex-wrap: wrap;
  }
  .stat { text-align: center; }
  .stat-num { font-size: 1.6rem; font-weight: 800; color: #F5A623; letter-spacing: -0.04em; display: block; }
  .stat-lbl { font-size: 0.75rem; color: #525252; font-weight: 500; }

  /* ── SECTION ──────────────────────────────────────────── */
  .section { max-width: 1200px; margin: 0 auto; padding: 48px 24px; }
  .section + .section { padding-top: 0; }
  .section-head {
    display: flex; align-items: flex-end; justify-content: space-between;
    margin-bottom: 20px; gap: 12px; flex-wrap: wrap;
  }
  .section-title { font-size: 1.15rem; font-weight: 700; color: #F5F5F5; letter-spacing: -0.02em; }
  .section-count {
    font-size: 0.75rem; color: #525252; font-weight: 500;
    background: #1a1a1a; border: 1px solid #262626;
    padding: 4px 10px; border-radius: 999px;
  }

  /* ── GRID ─────────────────────────────────────────────── */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 12px;
  }

  /* ── CARD ─────────────────────────────────────────────── */
  .card {
    display: flex; flex-direction: column;
    padding: 18px 20px 18px 22px;
    background: #141722;
    border: 1px solid #1E2333;
    border-radius: 10px;
    text-decoration: none;
    transition: border-color .2s, background .2s, transform .2s, box-shadow .2s;
    position: relative; overflow: hidden;
  }
  .card:hover {
    border-color: #2A3147;
    background: #1B1F30;
    transform: translateY(-3px);
    box-shadow: 0 12px 40px rgba(0,229,255,0.08), 0 8px 24px rgba(0,0,0,0.6);
  }
  /* Left accent bar always visible, glows on hover */
  .card-accent {
    position: absolute; top: 0; left: 0; bottom: 0; width: 3px;
    border-radius: 10px 0 0 10px;
    opacity: 0.4; transition: opacity .2s, width .2s;
  }
  .card:hover .card-accent { opacity: 1; width: 4px; }
  .card-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
  .card-icon { font-size: 1.5rem; line-height: 1; }
  .card-count { font-size: 0.7rem; font-weight: 600; color: #525252; font-family: 'Space Mono', monospace; }
  .card-title {
    font-size: 0.95rem; font-weight: 700; color: #E5E5E5;
    margin-bottom: 6px; letter-spacing: -0.01em; transition: color .2s;
  }
  .card:hover .card-title { color: #fff; }
  .card-desc { font-size: 0.78rem; color: #525252; line-height: 1.6; flex: 1; margin-bottom: 14px; }
  .card-footer {
    display: flex; align-items: center; justify-content: space-between;
    font-size: 0.72rem; font-weight: 600; color: #404040; transition: color .2s;
  }
  .card:hover .card-footer { color: #F5A623; }
  .card-arrow { font-size: 0.8rem; transition: transform .2s; }
  .card:hover .card-arrow { transform: translate(2px, -2px); }

  /* ── DIVIDER ──────────────────────────────────────────── */
  .divider { height: 1px; background: #1E2333; margin: 0 24px; }

  /* ── FOOTER ───────────────────────────────────────────── */
  .footer {
    border-top: 1px solid #1E2333; padding: 28px 32px;
    background: #0E1017;
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 12px;
  }
  .footer-text { font-size: 0.78rem; color: #404040; }
  .footer-text a { color: #F5A623; text-decoration: none; }
  .footer-text a:hover { text-decoration: underline; }

  /* ── ANIMATIONS ───────────────────────────────────────── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  [data-reveal] { opacity: 0; transform: translateY(12px); transition: opacity .5s, transform .5s; }
  [data-reveal].in { opacity: 1; transform: translateY(0); }
</style>

<!-- ── NAV ─────────────────────────────────────────────── -->
<header>
  <nav class="nav" aria-label="Main navigation">
    <div class="nav-left">
      <a href="/" class="nav-logo" aria-label="Cosmic home">✦ Cosmic</a>
      <div class="nav-links">
        <a href="/">Roadmaps</a>
        <a href="https://github.com/mantisdarling/cosmic" target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </div>
    <div class="nav-right">
      <a href="https://github.com/mantisdarling/cosmic" target="_blank" rel="noopener noreferrer" class="btn-ghost">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
        GitHub
      </a>
    </div>
  </nav>
</header>

<main>
  <!-- ── HERO ─────────────────────────────────────────── -->
  <div class="hero-container">
    <section class="hero" aria-labelledby="hero-heading">
      <div class="hero-eyebrow" data-reveal>
        <span class="eyebrow-dot" aria-hidden="true"></span>
        Community Roadmaps · Open Source · Free Forever
      </div>
      <h1 id="hero-heading" data-reveal>
        Developer <span>Roadmaps</span>
      </h1>
      <p data-reveal>
        Community created roadmaps, guides and resources to help you choose your path and grow in your developer career.
      </p>
      <p data-reveal style="font-size:0.9rem;color:#525252;margin-top:-16px;margin-bottom:24px;font-family:'Space Mono',monospace;">
        Built for <span id="scramble-text" style="color:#F5A623;font-weight:700;">Frontend Developers.</span>
      </p>
      <div class="hero-actions" data-reveal>
        <a href="#roadmaps" class="hero-primary">Browse Roadmaps</a>
        <button id="ai-generate-btn" class="hero-secondary" style="cursor: pointer; display: flex; align-items: center; gap: 8px;">
          🪄 Generate with AI
        </button>
        <a href="https://github.com/mantisdarling/cosmic" class="hero-secondary" target="_blank" rel="noopener noreferrer">
          ⭐ Star on GitHub
        </a>
      </div>

      <!-- AI Generate Modal / Input -->
      <div id="ai-generator-panel" style="display: none; max-width: 540px; margin: 0 auto 32px; background: #141722; border: 1px solid #1E2333; padding: 20px; border-radius: 12px; text-align: left;" data-reveal>
        <h3 style="color: #F5A623; font-size: 1rem; margin: 0 0 12px; font-weight: 700;">Build a custom roadmap</h3>
        <p style="color: #A3A3A3; font-size: 0.85rem; margin: 0 0 16px; line-height: 1.5;">Type any topic (e.g., 'Web3 with Rust' or 'Game Design') and our AI will generate an interactive roadmap instantly.</p>
        <form id="ai-generate-form" style="display: flex; gap: 8px;">
          <input type="text" id="ai-topic-input" placeholder="Enter a topic..." required style="flex: 1; padding: 10px 16px; border-radius: 8px; border: 1px solid #2A3147; background: #0E1017; color: #F5F5F5; font-size: 0.9rem;" />
          <button type="submit" id="ai-submit-btn" style="padding: 10px 20px; border-radius: 8px; background: #F5A623; color: #0D0D0D; font-weight: 600; border: none; cursor: pointer; transition: background 0.2s;">Generate</button>
        </form>
        <div id="ai-loading" style="display: none; margin-top: 16px; color: #00E5FF; font-size: 0.85rem; align-items: center; gap: 8px;">
          <div style="width: 16px; height: 16px; border: 2px solid rgba(0,229,255,0.2); border-top-color: #00E5FF; border-radius: 50%; animation: spin 1s linear infinite;"></div>
          Generating your roadmap... (this usually takes 5-10s)
        </div>
        <div id="ai-error" style="display: none; margin-top: 16px; color: #EF4444; font-size: 0.85rem; background: rgba(239,68,68,0.1); padding: 8px 12px; border-radius: 6px; border: 1px solid rgba(239,68,68,0.2);"></div>
      </div>

      <!-- ── SEARCH ──────────────────────────────────────── -->
      <div class="search-wrap" data-reveal>
        <span class="search-icon" aria-hidden="true">🔍</span>
        <input
          id="search-input"
          type="search"
          placeholder="Search roadmaps — frontend, python, devops…"
          autocomplete="off"
          aria-label="Search roadmaps"
        />
        <button id="favorites-filter-btn" class="btn-ghost" style="margin-left:8px;" aria-label="Toggle favorites">
          ⭐ Favorites
        </button>
        <span id="search-count" aria-live="polite"></span>
      </div>
    </section>
  </div>

  <!-- ── STATS ─────────────────────────────────────────── -->
  <div class="stats-bar" aria-label="Site statistics" data-reveal>
    <div class="stat">
      <span class="stat-num" id="stat-count">{all.length}</span>
      <span class="stat-lbl">Roadmaps</span>
    </div>
    <div class="stat">
      <span class="stat-num">{all.reduce((n, r) => n + r.nodes.length, 0)}+</span>
      <span class="stat-lbl">Topics</span>
    </div>
    <div class="stat">
      <span class="stat-num">100%</span>
      <span class="stat-lbl">Free</span>
    </div>
    <div class="stat">
      <span class="stat-num">AI</span>
      <span class="stat-lbl">Tutor</span>
    </div>
  </div>

  <div id="roadmaps">
    <div id="no-results" role="status">
      No roadmaps found for "<span id="no-results-query"></span>" — try a different keyword.
    </div>

    <!-- ── ROLE-BASED ──────────────────────────────────── -->
    <section class="section" aria-labelledby="role-heading" id="section-role">
      <div class="section-head">
        <h2 class="section-title" id="role-heading">Role-based Roadmaps</h2>
        <span class="section-count" id="role-count">{role.length} roadmaps</span>
      </div>
      <div class="grid" id="grid-role">
        {role.map((rm, i) => (
          <a
            href={`/roadmap/${rm.id}`}
            class="card"
            data-id={rm.id}
            data-title={rm.title.toLowerCase()}
            data-desc={rm.description.toLowerCase()}
            style={`animation: fadeUp .4s ease both; animation-delay: ${i * 0.04}s;`}
            aria-label={`${rm.title} — ${rm.nodes.length} topics`}
            data-reveal
          >
            <div class="card-accent" style={`background: ${rm.color}`} aria-hidden="true"></div>
            <div class="card-top">
              <span class="card-icon" role="img" aria-label={`${rm.title} icon`}>{rm.icon}</span>
              <span class="card-count">{rm.nodes.length} topics</span>
            </div>
            <div class="card-title">{rm.title}</div>
            <div class="card-desc">{rm.description}</div>
            <div class="card-footer">
              <span style={`color: ${rm.color}; font-size: 0.7rem; font-weight: 600;`}>Community</span>
              <span class="card-arrow">↗</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <div class="divider"></div>

    <!-- ── SKILL-BASED ─────────────────────────────────── -->
    <section class="section" aria-labelledby="skill-heading" id="section-skill">
      <div class="section-head">
        <h2 class="section-title" id="skill-heading">Skill-based Roadmaps</h2>
        <span class="section-count" id="skill-count">{skill.length} roadmaps</span>
      </div>
      <div class="grid" id="grid-skill">
        {skill.map((rm, i) => (
          <a
            href={`/roadmap/${rm.id}`}
            class="card"
            data-id={rm.id}
            data-title={rm.title.toLowerCase()}
            data-desc={rm.description.toLowerCase()}
            style={`animation: fadeUp .4s ease both; animation-delay: ${i * 0.04}s;`}
            aria-label={`${rm.title} — ${rm.nodes.length} topics`}
            data-reveal
          >
            <div class="card-accent" style={`background: ${rm.color}`} aria-hidden="true"></div>
            <div class="card-top">
              <span class="card-icon" role="img" aria-label={`${rm.title} icon`}>{rm.icon}</span>
              <span class="card-count">{rm.nodes.length} topics</span>
            </div>
            <div class="card-title">{rm.title}</div>
            <div class="card-desc">{rm.description}</div>
            <div class="card-footer">
              <span style={`color: ${rm.color}; font-size: 0.7rem; font-weight: 600;`}>Community</span>
              <span class="card-arrow">↗</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    {other.length > 0 && (
      <>
        <div class="divider"></div>
        <section class="section" aria-labelledby="other-heading" id="section-other">
          <div class="section-head">
            <h2 class="section-title" id="other-heading">More Roadmaps</h2>
            <span class="section-count" id="other-count">{other.length} roadmaps</span>
          </div>
          <div class="grid" id="grid-other">
            {other.map((rm, i) => (
              <a
                href={`/roadmap/${rm.id}`}
                class="card"
                data-id={rm.id}
                data-title={rm.title.toLowerCase()}
                data-desc={rm.description.toLowerCase()}
                style={`animation: fadeUp .4s ease both; animation-delay: ${i * 0.04}s;`}
                aria-label={`${rm.title} — ${rm.nodes.length} topics`}
                data-reveal
              >
                <div class="card-accent" style={`background: ${rm.color}`} aria-hidden="true"></div>
                <div class="card-top">
                  <span class="card-icon">{rm.icon}</span>
                  <span class="card-count">{rm.nodes.length} topics</span>
                </div>
                <div class="card-title">{rm.title}</div>
                <div class="card-desc">{rm.description}</div>
                <div class="card-footer">
                  <span style={`color: ${rm.color}; font-size: 0.7rem; font-weight: 600;`}>Community</span>
                  <span class="card-arrow">↗</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      </>
    )}
  </div>
</main>

<!-- ── FOOTER ──────────────────────────────────────────── -->
<footer class="footer" role="contentinfo">
  <span class="footer-text">© 2026 Cosmic · All roadmaps are <a href="https://github.com/mantisdarling/cosmic">open source</a></span>
  <span class="footer-text">Built with <a href="https://astro.build">Astro</a> · <a href="https://reactflow.dev">React Flow</a> · Hosted on <a href="https://vercel.com">Vercel</a></span>
</footer>

<script>
  import { cleanAndParseJSON } from '../lib/security';

  // Scroll reveal animation observer
  const revealObserver = new IntersectionObserver(
    (entries) =>
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in');
          revealObserver.unobserve(entry.target);
        }
      }),
    { threshold: 0.05, rootMargin: '0px 0px -10px 0px' }
  );

  requestAnimationFrame(() =>
    document.querySelectorAll('[data-reveal]').forEach((element) => revealObserver.observe(element))
  );

  // Hero title text scrambling animation
  const SCRAMBLE_CHARACTERS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%&';
  const DEVELOPER_ROLES = [
    'Frontend Developers.',
    'Backend Engineers.',
    'DevOps Pros.',
    'Full-Stack Builders.',
    'AI/ML Learners.',
    'Cyber Security folks.',
    'Open Source contributors.',
  ];

  const scrambleElement = document.getElementById('scramble-text');
  let currentRoleIndex = 0;

  function runScrambleAnimation(targetText: string) {
    let iteration = 0;
    const maxIterations = targetText.length * 3;

    const scrambleInterval = setInterval(() => {
      if (!scrambleElement) return;
      scrambleElement.textContent = targetText
        .split('')
        .map((char, index) => {
          if (char === ' ') return ' ';
          if (index < Math.floor(iteration / 3)) return targetText[index];
          return SCRAMBLE_CHARACTERS[Math.floor(Math.random() * SCRAMBLE_CHARACTERS.length)];
        })
        .join('');

      iteration++;
      if (iteration > maxIterations) {
        clearInterval(scrambleInterval);
        scrambleElement.textContent = targetText;
      }
    }, 28);
  }

  setInterval(() => {
    currentRoleIndex = (currentRoleIndex + 1) % DEVELOPER_ROLES.length;
    runScrambleAnimation(DEVELOPER_ROLES[currentRoleIndex]);
  }, 3500);

  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const favoritesBtn = document.getElementById('favorites-filter-btn') as HTMLButtonElement;
  const searchCountElement = document.getElementById('search-count')!;
  const noResultsElement = document.getElementById('no-results')!;
  const noResultsQueryElement = document.getElementById('no-results-query')!;
  const allCardElements = Array.from(document.querySelectorAll<HTMLAnchorElement>('.card'));

  let showFavoritesOnly = false;

  function getBookmarks() {
    try {
      return new Set(JSON.parse(localStorage.getItem('cosmic-bookmarks') || '[]'));
    } catch {
      return new Set();
    }
  }

  function filterRoadmaps() {
    const rawQuery = searchInput?.value || '';
    const searchQuery = rawQuery.trim().toLowerCase();
    let visibleCardCount = 0;
    const bookmarks = getBookmarks();

    allCardElements.forEach((card) => {
      const cardTitle = card.dataset.title ?? '';
      const cardDescription = card.dataset.desc ?? '';
      const cardId = card.dataset.id ?? '';
      const isSearchMatch = !searchQuery || cardTitle.includes(searchQuery) || cardDescription.includes(searchQuery);
      const isFavoriteMatch = !showFavoritesOnly || bookmarks.has(cardId);
      
      const isMatch = isSearchMatch && isFavoriteMatch;

      card.classList.toggle('hidden', !isMatch);
      if (isMatch) visibleCardCount++;
    });

    searchCountElement.textContent = searchQuery ? `${visibleCardCount} found` : '';
    noResultsElement.style.display = searchQuery && visibleCardCount === 0 ? 'block' : 'none';
    noResultsQueryElement.textContent = searchQuery;

    // Toggle section visibility based on matching cards
    ['role', 'skill', 'other'].forEach((sectionId) => {
      const sectionElement = document.getElementById(`section-${sectionId}`);
      if (!sectionElement) return;
      const hasVisibleCards = Array.from(sectionElement.querySelectorAll('.card')).some(
        (card) => !card.classList.contains('hidden')
      );
      sectionElement.style.display = hasVisibleCards ? '' : 'none';
    });
  }

  if (searchInput) {
    searchInput.addEventListener('input', () => filterRoadmaps());
    searchInput.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        searchInput.value = '';
        filterRoadmaps();
        searchInput.blur();
      }
    });

    // Global shortcut to focus search
    window.addEventListener('keydown', (event) => {
      if (event.key === '/' && document.activeElement !== searchInput && document.activeElement !== document.getElementById('ai-topic-input')) {
        event.preventDefault();
        searchInput.focus();
      }
    });

    // ── AI GENERATOR LOGIC ──────────────────────────────────────────
    const aiBtn = document.getElementById('ai-generate-btn');
    const aiPanel = document.getElementById('ai-generator-panel');
    const aiForm = document.getElementById('ai-generate-form');
    const aiInput = document.getElementById('ai-topic-input') as HTMLInputElement | null;
    const aiSubmitBtn = document.getElementById('ai-submit-btn') as HTMLButtonElement | null;
    const aiLoading = document.getElementById('ai-loading');
    const aiError = document.getElementById('ai-error');

    if (aiBtn && aiPanel && aiForm && aiInput && aiSubmitBtn && aiLoading && aiError) {
      aiBtn.addEventListener('click', () => {
        const isHidden = aiPanel.style.display === 'none';
        aiPanel.style.display = isHidden ? 'block' : 'none';
        if (isHidden) aiInput.focus();
      });

      aiForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const topic = aiInput.value.trim();
        if (!topic) return;

        aiSubmitBtn.disabled = true;
        aiSubmitBtn.style.opacity = '0.6';
        aiLoading.style.display = 'flex';
        aiError.style.display = 'none';

        try {
          const response = await fetch('/api/ai', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ topic, action: 'generate' }),
          });
          const data = await response.json();
          if (!response.ok || data.error) {
            throw new Error(data.error ?? 'Generation failed.');
          }

          const parsed = cleanAndParseJSON(data.text);
          sessionStorage.setItem('custom_roadmap_data', JSON.stringify(parsed));
          window.location.href = '/roadmap/custom';
        } catch (err) {
          const msg = err instanceof Error ? err.message : 'Failed to parse AI response. Please try another topic.';
          aiError.textContent = msg;
          aiError.style.display = 'block';
          aiSubmitBtn.disabled = false;
          aiSubmitBtn.style.opacity = '1';
          aiLoading.style.display = 'none';
        }
      });
    }
  }
  
  if (favoritesBtn) {
    favoritesBtn.addEventListener('click', () => {
      showFavoritesOnly = !showFavoritesOnly;
      favoritesBtn.style.color = showFavoritesOnly ? '#F5A623' : '#A3A3A3';
      favoritesBtn.style.borderColor = showFavoritesOnly ? '#F5A623' : '#262626';
      filterRoadmaps();
    });
  }

  window.addEventListener('cosmic-bookmarks-updated', filterRoadmaps);
</script>

</BaseLayout>
