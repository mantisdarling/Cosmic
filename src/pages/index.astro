---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookmarkToggle from '../components/BookmarkToggle';
import { RoadmapSchema, cleanAndParseJSON, type Roadmap } from '../lib/security';

// Load all roadmaps
const modules = import.meta.glob('../content/roadmaps/*.json', { eager: true });
const all: Roadmap[] = Object.values(modules)
  .map((m: any) => { const r = RoadmapSchema.safeParse(m.default ?? m); return r.success ? r.data : null; })
  .filter((r): r is Roadmap => r !== null)
  .sort((a, b) => a.title.localeCompare(b.title));

// Category buckets — updated with new roadmap IDs
const roleIds = [
  'fullstack','frontend','backend','devops','ai-engineer','ml-engineer',
  'android','cybersecurity','data-analyst','blockchain','cloud-engineer',
  'software-architect','qa-engineer','game-dev','react-native',
];
const skillIds = [
  'javascript','typescript','python','react','nodejs','java','go','rust',
  'cpp','csharp','php','ruby','swift','flutter','angular','vue',
  'nextjs-full','django','spring','sql','postgresql','mongodb',
  'graphql','redis','system-design','docker','kubernetes','linux',
  'aws','git','terraform','cicd','html-css','computer-science','api-design',
];

const role  = roleIds.map(id => all.find(r => r.id === id)).filter(Boolean) as Roadmap[];
const skill = skillIds.map(id => all.find(r => r.id === id)).filter(Boolean) as Roadmap[];
const other = all.filter(r => !roleIds.includes(r.id) && !skillIds.includes(r.id));
---

<BaseLayout title="Cosmic — Developer Roadmaps" description="Community created roadmaps, guides and resources to help you grow in your developer career.">

<style>
  /* ── NAV ─────────────────────────────────────────────── */
  .nav {
    position: sticky; top: 0; z-index: 50;
    height: 62px;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 32px;
    background: rgba(7, 9, 16, 0.84);
    backdrop-filter: blur(18px) saturate(130%);
    border-bottom: 1px solid rgba(91, 106, 148, 0.28);
    box-shadow: 0 10px 40px rgba(0,0,0,0.22);
  }
  .nav::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 1px;
    background: linear-gradient(90deg, transparent 0%, rgba(0,229,255,0.6) 28%, rgba(245,166,35,0.8) 68%, transparent 100%);
    opacity: .7;
  }
  .nav-left { display: flex; align-items: center; gap: 28px; }
  .nav-logo {
    font-weight: 900; font-size: 1.08rem; letter-spacing: -0.04em;
    color: #F5A623; text-decoration: none;
    text-shadow: 0 0 22px rgba(245,166,35,0.24);
  }
  .nav-logo::first-letter { color: #00E5FF; }
  .nav-links { display: flex; gap: 2px; }
  .nav-links a {
    padding: 6px 12px; border-radius: 6px;
    font-size: 0.82rem; font-weight: 500; color: #A3A3A3;
    text-decoration: none; transition: color .15s, background .15s;
  }
  .nav-links a:hover { color: #F5F5F5; background: #1f1f1f; }
  .nav-right { display: flex; align-items: center; gap: 10px; }
  .btn-ghost {
    padding: 7px 14px; border-radius: 7px;
    font-size: 0.8rem; font-weight: 500; color: #A3A3A3;
    background: none; border: 1px solid #262626;
    cursor: pointer; transition: all .15s;
    text-decoration: none; display: inline-flex; align-items: center; gap: 6px;
  }
  .btn-ghost:hover { color: #F5F5F5; border-color: #404040; background: #1a1a1a; }
  /* Theme toggle */
  #theme-toggle {
    width: 34px; height: 34px; border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    background: none; border: 1px solid #262626;
    color: #737373; font-size: 1rem; cursor: pointer;
    transition: all .15s;
  }
  #theme-toggle:hover { border-color: #404040; background: #1a1a1a; color: #F5F5F5; }
  @media (max-width: 760px) {
    .nav { height: 58px; padding: 0 18px; }
    .nav-links { display: none; }
    .hero { min-height: 0; padding: 76px 22px 42px; text-align: center; align-items: center; }
    .hero h1 { font-size: clamp(2.55rem, 13vw, 4rem); }
    .hero p { margin-left: auto; margin-right: auto; }
    .hero-actions { justify-content: center; }
    .hero-signal { justify-content: center !important; }
    .search-container { margin: 0 auto; }
    .hero-container { background-position: 68% center; }
    .hero-container::after { width: 280px; height: 280px; right: -80px; top: 18%; }
    .hero-badges { opacity: .68; }
    .hero-badge-frontend { top: 12%; left: 8%; }
    .hero-badge-ai { top: 22%; right: 5%; }
    .hero-badge-cloud { bottom: 14%; left: 7%; }
    .hero-badge-devops { bottom: 22%; right: 7%; }
  }
  @media (max-width: 640px) { .nav-links { display: none; } }

  /* ── HERO CONTAINER ─────────────────────────────────── */
  .hero-container {
    --pointer-x: 0;
    --pointer-y: 0;
    position: relative; overflow: hidden;
    background-image:
      linear-gradient(90deg, rgba(6,9,18,0.96) 0%, rgba(6,9,18,0.86) 34%, rgba(6,9,18,0.36) 66%, rgba(6,9,18,0.78) 100%),
      linear-gradient(180deg, rgba(7,9,16,0.18) 0%, rgba(7,9,16,0.12) 45%, #0B0C10 100%),
      url('/cosmic-anime-hero.png');
    background-size: cover;
    background-position: center right;
    border-bottom: 1px solid #1E2333;
    isolation: isolate;
  }
  .hero-container::before {
    content: ''; position: absolute; inset: 0; pointer-events: none; z-index: -1;
    background: repeating-linear-gradient(0deg, transparent 0 3px, rgba(255,255,255,0.012) 4px 5px);
    mix-blend-mode: screen; opacity: .45;
  }
  .hero-container::after {
    content: ''; position: absolute; width: 420px; height: 420px; right: 8%; top: 12%;
    border: 1px solid rgba(0,229,255,0.14); border-radius: 50%;
    box-shadow: 0 0 0 22px rgba(0,229,255,0.025), 0 0 0 52px rgba(245,166,35,0.018);
    pointer-events: none; z-index: -1;
    transform: translate3d(calc(var(--pointer-x) * 18px), calc(var(--pointer-y) * 12px), 0);
    transition: transform .35s ease-out;
  }
  .hero-particle-field { position: absolute; inset: 0; z-index: 1; pointer-events: none; }
  #hero-particles { width: 100%; height: 100%; display: block; opacity: .9; }
  .hero-badges { position: absolute; inset: 0; max-width: 1260px; margin: 0 auto; z-index: 2; pointer-events: none; }
  .hero-badge {
    --badge-shift-x: 0px; --badge-shift-y: 0px;
    position: absolute; display: inline-flex; padding: 6px 10px;
    border: 1px solid rgba(127, 150, 205, 0.42); border-radius: 999px;
    background: rgba(11, 17, 31, 0.68); color: #B8C5E2;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.07), 0 10px 30px rgba(0,0,0,0.24), 0 0 18px rgba(0,229,255,0.08);
    backdrop-filter: blur(10px); font: 700 .68rem/1 'Space Mono', monospace;
    letter-spacing: .04em; white-space: nowrap;
    transform: translate3d(var(--badge-shift-x), var(--badge-shift-y), 0);
    transition: transform .35s ease-out, border-color .2s, color .2s;
  }
  .hero-badge::before { content: ''; width: 6px; height: 6px; margin-right: 7px; border-radius: 50%; background: #00E5FF; box-shadow: 0 0 10px currentColor; }
  .hero-badge > span { animation: badge-float 4.5s ease-in-out infinite; display: inline-flex; align-items: center; }
  .hero-badge:hover { border-color: rgba(0,229,255,0.8); color: #F5F5F5; }
  .hero-badge-frontend { top: 22%; left: 57%; color: #B5F4FF; }
  .hero-badge-frontend::before { background: #00E5FF; }
  .hero-badge-ai { top: 37%; right: 5%; color: #FFE0A2; animation-delay: -.9s; }
  .hero-badge-ai::before { background: #F5A623; }
  .hero-badge-cloud { bottom: 21%; left: 63%; color: #D2C4FF; animation-delay: -1.8s; }
  .hero-badge-cloud::before { background: #A78BFA; }
  .hero-badge-devops { bottom: 28%; right: 13%; color: #B7FFD8; animation-delay: -2.7s; }
  .hero-badge-devops::before { background: #22C55E; }
  @keyframes badge-float { 0%,100% { transform: translateY(0) rotate(-1deg); } 50% { transform: translateY(-7px) rotate(1deg); } }

  /* ── HERO ─────────────────────────────────────────────── */
  .hero {
    max-width: 1200px; margin: 0 auto;
    padding: 96px 32px 64px;
    text-align: left;
    min-height: 540px;
    display: flex; flex-direction: column; align-items: flex-start; justify-content: center;
  }
  .hero-eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 6px 13px 6px 9px; border-radius: 999px;
    background: rgba(245,166,35,0.1); border: 1px solid rgba(245,166,35,0.3);
    box-shadow: 0 0 24px rgba(245,166,35,0.08);
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.04em; color: #F5C45F;
    margin-bottom: 20px; cursor: default; text-transform: uppercase;
  }
  .eyebrow-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: #F5A623; animation: eyebrow-pulse 2s ease-in-out infinite;
  }
  @keyframes eyebrow-pulse { 0%,100% { opacity:1; } 50% { opacity:.35; } }
  .hero h1 {
    max-width: 720px;
    font-size: clamp(2.8rem, 7vw, 5.25rem);
    font-weight: 900; letter-spacing: -0.065em; line-height: 0.98;
    color: #F8FAFF; margin-bottom: 22px;
    text-wrap: balance;
    text-shadow: 0 12px 40px rgba(0,0,0,0.45);
  }
  .hero h1 span {
    color: #F5A623;
    background: linear-gradient(105deg, #F5A623 12%, #FCD068 48%, #00E5FF 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .hero p {
    font-size: 1.03rem; line-height: 1.75; color: #A8B0C2;
    max-width: 600px; margin: 0 0 18px;
  }
  .hero-actions { display: flex; gap: 10px; justify-content: flex-start; flex-wrap: wrap; margin-bottom: 30px; }
  .hero-actions a, .hero-actions button {
    padding: 11px 22px; border-radius: 9px;
    font-size: 0.9rem; font-weight: 600; text-decoration: none;
    font-family: inherit; cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    transition: all .2s; line-height: 1.2;
  }
  .hero-primary { background: #F5A623; color: #0D0D0D; border: 1px solid transparent; }
  .hero-primary:hover { background: #FCD068; transform: translateY(-1px); }
  .hero-secondary { background: #141722; color: #F5F5F5; border: 1px solid #1E2333; }
  .hero-secondary:hover { border-color: #2A3147; background: #1B1F30; transform: translateY(-1px); }

  /* ── SEARCH ──────────────────────────────────────────── */
  .search-container {
    width: min(100%, 680px); max-width: 680px; margin: 0 0 0;
    display: flex; align-items: center; gap: 10px;
  }
  .search-box {
    position: relative; flex: 1; display: flex; align-items: center;
  }
  .search-icon {
    position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
    color: #525252; pointer-events: none;
    display: flex; align-items: center; justify-content: center;
    width: 20px; height: 20px;
    transition: color .2s;
  }
  .search-box:focus-within .search-icon {
    color: #F5A623;
  }
  #search-input {
    width: 100%; height: 46px; padding: 0 64px 0 42px;
    background: #141722; border: 1px solid #1E2333;
    border-radius: 10px; color: #F5F5F5;
    font-size: 0.92rem; font-family: inherit;
    transition: border-color .2s, box-shadow .2s;
    outline: none; box-sizing: border-box;
  }
  #search-input::placeholder { color: #666B78; }
  #search-input:focus { border-color: rgba(245,166,35,0.5); box-shadow: 0 0 0 3px rgba(245,166,35,0.08); }
  #search-count {
    position: absolute; right: 14px; top: 50%; transform: translateY(-50%);
    font-size: 0.72rem; color: #525252; font-family: 'Space Mono', monospace;
    pointer-events: none; white-space: nowrap;
  }
  .filter-btn {
    height: 46px; padding: 0 16px; border-radius: 10px;
    background: #141722; border: 1px solid #1E2333;
    color: #A3A3A3; font-size: 0.85rem; font-weight: 600;
    font-family: inherit; cursor: pointer;
    display: inline-flex; align-items: center; gap: 6px;
    white-space: nowrap; transition: all .2s;
    box-sizing: border-box;
  }
  .filter-btn:hover {
    background: #1B1F30; border-color: #2A3147; color: #F5F5F5;
  }
  .filter-btn.active {
    background: rgba(245,166,35,0.12); border-color: #F5A623; color: #F5A623;
  }
  @media (max-width: 540px) {
    .search-container { flex-direction: column; }
    .search-box { width: 100%; }
    .filter-btn { width: 100%; justify-content: center; }
  }
  #no-results {
    display: none; text-align: center;
    padding: 64px 24px; color: #737783; font-size: 0.9rem;
  }
  .clear-filters {
    display: inline-flex; align-items: center; justify-content: center;
    margin-top: 14px; padding: 8px 14px; border-radius: 8px;
    border: 1px solid #2A3147; background: #141722; color: #F5A623;
    font: 600 0.8rem/1.2 inherit; cursor: pointer;
    transition: background .2s, border-color .2s, transform .2s;
  }
  .clear-filters:hover { background: #1B1F30; border-color: #F5A623; transform: translateY(-1px); }
  .clear-filters:focus-visible, .filter-btn:focus-visible, .hero-actions a:focus-visible, .hero-actions button:focus-visible, #search-input:focus-visible {
    outline: 2px solid #FCD068; outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-container *, .card, .clear-filters { animation: none !important; transition: none !important; }
    .hero-badges { display: none; }
  }

  /* ── STATS ────────────────────────────────────────────── */
  .stats-bar {
    position: relative; border-top: 1px solid #1E2333; border-bottom: 1px solid #1E2333;
    background: linear-gradient(90deg, #0B0C10, #101522 45%, #0B0C10); padding: 22px 32px;
    display: flex; align-items: center; justify-content: center;
    gap: 56px; flex-wrap: wrap;
  }
  .stats-bar::before, .stats-bar::after { content: ''; position: absolute; width: 7px; height: 7px; border: 1px solid #00E5FF; transform: rotate(45deg); opacity: .7; }
  .stats-bar::before { left: 32px; }
  .stats-bar::after { right: 32px; border-color: #F5A623; }
  .stat { text-align: center; }
  .stat-num { font-size: 1.75rem; font-weight: 900; color: #F5A623; letter-spacing: -0.05em; display: block; text-shadow: 0 0 18px rgba(245,166,35,0.2); }
  .stat-lbl { font-size: 0.68rem; color: #8992A8; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }

  /* ── SECTION ──────────────────────────────────────────── */
  .section { max-width: 1200px; margin: 0 auto; padding: 48px 24px; }
  .section + .section { padding-top: 0; }
  .section-head {
    display: flex; align-items: flex-end; justify-content: space-between;
    margin-bottom: 20px; gap: 12px; flex-wrap: wrap;
  }
  .section-title { position: relative; padding-left: 15px; font-size: 1.15rem; font-weight: 800; color: #F5F5F5; letter-spacing: -0.03em; }
  .section-title::before { content: ''; position: absolute; left: 0; top: 4px; bottom: 4px; width: 3px; border-radius: 99px; background: linear-gradient(#00E5FF, #F5A623); box-shadow: 0 0 12px rgba(0,229,255,0.45); }
  .section-count {
    font-size: 0.75rem; color: #525252; font-weight: 500;
    background: #1a1a1a; border: 1px solid #262626;
    padding: 4px 10px; border-radius: 999px;
  }

  /* ── GRID ─────────────────────────────────────────────── */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 12px;
  }

  /* ── CARD ─────────────────────────────────────────────── */
  .card {
    display: flex; flex-direction: column;
    min-height: 190px;
    padding: 19px 20px 18px 22px;
    background: linear-gradient(145deg, rgba(20,23,34,0.98), rgba(14,18,29,0.98));
    border: 1px solid rgba(55,67,98,0.62);
    border-radius: 14px;
    text-decoration: none;
    transition: border-color .24s, background .24s, transform .24s, box-shadow .24s;
    position: relative; overflow: hidden;
  }
  .card::after {
    content: ''; position: absolute; inset: 0; pointer-events: none; opacity: 0;
    background: linear-gradient(120deg, rgba(0,229,255,0.06), transparent 38%, rgba(245,166,35,0.04));
    transition: opacity .24s;
  }
  .card:hover {
    border-color: rgba(0,229,255,0.52);
    background: linear-gradient(145deg, #1A2032, #121A2C);
    transform: translateY(-5px);
    box-shadow: 0 18px 46px rgba(0,0,0,0.55), 0 0 28px rgba(0,229,255,0.09);
  }
  .card:hover::after { opacity: 1; }
  /* Left accent bar always visible, glows on hover */
  .card-accent {
    position: absolute; top: 0; left: 0; bottom: 0; width: 3px;
    border-radius: 10px 0 0 10px;
    opacity: 0.4; transition: opacity .2s, width .2s;
  }
  .card:hover .card-accent { opacity: 1; width: 4px; }
  .card-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; height: 32px; }
  .card-icon {
    font-size: 1.5rem; line-height: 1;
    display: inline-flex; align-items: center; justify-content: center;
    width: 32px; height: 32px; flex-shrink: 0;
  }
  .card-count {
    font-size: 0.7rem; font-weight: 600; color: #525252;
    font-family: 'Space Mono', monospace; line-height: 1;
    background: #0E1017; border: 1px solid #1E2333;
    padding: 4px 8px; border-radius: 999px;
  }
  .card-title {
    font-size: 0.95rem; font-weight: 700; color: #E5E5E5;
    margin-bottom: 6px; letter-spacing: -0.01em; transition: color .2s;
  }
  .card:hover .card-title { color: #fff; }
  .card-desc { font-size: 0.78rem; color: #737783; line-height: 1.6; flex: 1; margin-bottom: 14px; }
  .card-footer {
    display: flex; align-items: center; justify-content: space-between;
    font-size: 0.72rem; font-weight: 600; color: #737783; transition: color .2s;
  }
  .card:hover .card-footer { color: #F5A623; }
  .card-arrow { font-size: 0.8rem; transition: transform .2s; }
  .card:hover .card-arrow { transform: translate(2px, -2px); }

  /* ── DIVIDER ──────────────────────────────────────────── */
  .divider { height: 1px; background: #1E2333; margin: 0 24px; }

  /* ── FOOTER ───────────────────────────────────────────── */
  .footer {
    border-top: 1px solid #1E2333; padding: 28px 32px;
    background: #0E1017;
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 12px;
  }
  .footer-text { font-size: 0.78rem; color: #404040; }
  .footer-text a { color: #F5A623; text-decoration: none; }
  .footer-text a:hover { text-decoration: underline; }

  /* ── ANIMATIONS ───────────────────────────────────────── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  [data-reveal] { opacity: 0; transform: translateY(12px); transition: opacity .5s, transform .5s; }
  [data-reveal].in { opacity: 1; transform: translateY(0); }
</style>

<!-- ── NAV ─────────────────────────────────────────────── -->
<header>
  <nav class="nav" aria-label="Main navigation">
    <div class="nav-left">
      <a href="/" class="nav-logo" aria-label="Cosmic home">✦ Cosmic</a>
      <div class="nav-links">
        <a href="/">Roadmaps</a>
        <a href="https://github.com/mantisdarling/cosmic" target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </div>
    <div class="nav-right">
      <a href="https://github.com/mantisdarling/cosmic" target="_blank" rel="noopener noreferrer" class="btn-ghost">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
        GitHub
      </a>
    </div>
  </nav>
</header>

<main>
  <!-- ── HERO ─────────────────────────────────────────── -->
  <div class="hero-container">
    <div class="hero-particle-field" aria-hidden="true"><canvas id="hero-particles"></canvas></div>
    <div class="hero-badges" aria-hidden="true">
      <span class="hero-badge hero-badge-frontend" data-depth="1.2"><span>FRONTEND // 01</span></span>
      <span class="hero-badge hero-badge-ai" data-depth="1.8"><span>AI SYSTEMS // 02</span></span>
      <span class="hero-badge hero-badge-cloud" data-depth="1.4"><span>CLOUD ARC // 03</span></span>
      <span class="hero-badge hero-badge-devops" data-depth="2.1"><span>DEVOPS // 04</span></span>
    </div>
    <section class="hero hero-content" aria-labelledby="hero-heading">
      <div class="hero-eyebrow" data-reveal>
        <span class="eyebrow-dot" aria-hidden="true"></span>
        Community Roadmaps · Open Source · Free Forever
      </div>
      <h1 id="hero-heading" data-reveal>
        Developer <span>Roadmaps</span>
      </h1>
      <p data-reveal>
        Community created roadmaps, guides and resources to help you choose your path and grow in your developer career.
      </p>
      <p data-reveal class="hero-signal" style="font-size:0.78rem;color:#737B8F;margin:0 0 28px;font-family:'Space Mono',monospace;min-height:1.4em;display:flex;align-items:center;justify-content:flex-start;gap:8px;">
        Built for <span id="scramble-text" style="color:#F5A623;font-weight:700;">Frontend Developers.</span>
      </p>
      <div class="hero-actions" data-reveal>
        <a href="#roadmaps" class="hero-primary">Browse Roadmaps</a>
        <button id="ai-generate-btn" class="hero-secondary">
          <span>🪄</span>
          <span>Generate with AI</span>
        </button>
        <a href="https://github.com/mantisdarling/cosmic" class="hero-secondary" target="_blank" rel="noopener noreferrer">
          <span>⭐</span>
          <span>Star on GitHub</span>
        </a>
      </div>

      <!-- AI Generate Modal / Input -->
      <div id="ai-generator-panel" style="display: none; max-width: 580px; margin: 0 auto 36px; background: #141722; border: 1px solid #1E2333; padding: 22px; border-radius: 12px; text-align: left;" data-reveal>
        <h3 style="color: #F5A623; font-size: 1rem; margin: 0 0 10px; font-weight: 700; display: flex; align-items: center; gap: 8px;">
          <span>🪄</span>
          <span>Build a custom roadmap</span>
        </h3>
        <p style="color: #A3A3A3; font-size: 0.85rem; margin: 0 0 16px; line-height: 1.5;">Type any topic (e.g., 'Web3 with Rust' or 'Game Design') and our AI will generate an interactive roadmap instantly.</p>
        <form id="ai-generate-form" style="display: flex; gap: 10px; flex-wrap: wrap;">
          <input type="text" id="ai-topic-input" placeholder="Enter a topic..." required style="flex: 1; min-width: 220px; height: 42px; padding: 0 16px; border-radius: 8px; border: 1px solid #2A3147; background: #0E1017; color: #F5F5F5; font-size: 0.9rem; outline: none; font-family: inherit;" />
          <button type="submit" id="ai-submit-btn" style="height: 42px; padding: 0 20px; border-radius: 8px; background: #F5A623; color: #0D0D0D; font-weight: 600; border: none; cursor: pointer; transition: background 0.2s; font-family: inherit; font-size: 0.88rem;">Generate</button>
        </form>
        <div id="ai-loading" style="display: none; margin-top: 16px; color: #00E5FF; font-size: 0.85rem; align-items: center; gap: 8px;">
          <div style="width: 16px; height: 16px; border: 2px solid rgba(0,229,255,0.2); border-top-color: #00E5FF; border-radius: 50%; animation: spin 1s linear infinite; flex-shrink: 0;"></div>
          Generating your roadmap... (this usually takes 5-10s)
        </div>
        <div id="ai-error" style="display: none; margin-top: 16px; color: #EF4444; font-size: 0.85rem; background: rgba(239,68,68,0.1); padding: 8px 12px; border-radius: 6px; border: 1px solid rgba(239,68,68,0.2);"></div>
      </div>

      <!-- ── SEARCH ──────────────────────────────────────── -->
      <div class="search-container" data-reveal>
        <div class="search-box">
          <span class="search-icon" aria-hidden="true">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </span>
          <input
            id="search-input"
            type="search"
            placeholder="Search roadmaps — frontend, python, devops…"
            autocomplete="off"
            aria-label="Search roadmaps"
          />
          <span id="search-count" aria-live="polite"></span>
        </div>
        <button id="favorites-filter-btn" class="filter-btn" aria-label="Toggle favorites" aria-pressed="false">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" stroke="none">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
          <span>Favorites</span>
        </button>
      </div>
    </section>
  </div>

  <!-- ── STATS ─────────────────────────────────────────── -->
  <div class="stats-bar" aria-label="Site statistics" data-reveal>
    <div class="stat">
      <span class="stat-num" id="stat-count">{all.length}</span>
      <span class="stat-lbl">Roadmaps</span>
    </div>
    <div class="stat">
      <span class="stat-num">{all.reduce((n, r) => n + r.nodes.length, 0)}+</span>
      <span class="stat-lbl">Topics</span>
    </div>
    <div class="stat">
      <span class="stat-num">100%</span>
      <span class="stat-lbl">Free</span>
    </div>
    <div class="stat">
      <span class="stat-num">AI</span>
      <span class="stat-lbl">Tutor</span>
    </div>
  </div>

  <div id="roadmaps">
    <div id="no-results" role="status">
      <span id="no-results-copy">No roadmaps found for "<span id="no-results-query"></span>" — try a different keyword.</span>
      <button id="clear-filters" class="clear-filters" type="button">Clear filters</button>
    </div>

    <!-- ── ROLE-BASED ──────────────────────────────────── -->
    <section class="section" aria-labelledby="role-heading" id="section-role">
      <div class="section-head">
        <h2 class="section-title" id="role-heading">Role-based Roadmaps</h2>
        <span class="section-count" id="role-count">{role.length} roadmaps</span>
      </div>
      <div class="grid" id="grid-role">
        {role.map((rm, i) => (
          <a
            href={`/roadmap/${rm.id}`}
            class="card"
            data-id={rm.id}
            data-title={rm.title.toLowerCase()}
            data-desc={rm.description.toLowerCase()}
            style={`animation: fadeUp .4s ease both; animation-delay: ${i * 0.04}s;`}
            aria-label={`${rm.title} — ${rm.nodes.length} topics`}
            data-reveal
          >
            <div class="card-accent" style={`background: ${rm.color}`} aria-hidden="true"></div>
            <div class="card-top">
              <span class="card-icon" role="img" aria-label={`${rm.title} icon`}>{rm.icon}</span>
              <span class="card-count">{rm.nodes.length} topics</span>
            </div>
            <div class="card-title">{rm.title}</div>
            <div class="card-desc">{rm.description}</div>
            <div class="card-footer">
              <span style={`color: ${rm.color}; font-size: 0.7rem; font-weight: 600;`}>Community</span>
              <span class="card-arrow">↗</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <div class="divider"></div>

    <!-- ── SKILL-BASED ─────────────────────────────────── -->
    <section class="section" aria-labelledby="skill-heading" id="section-skill">
      <div class="section-head">
        <h2 class="section-title" id="skill-heading">Skill-based Roadmaps</h2>
        <span class="section-count" id="skill-count">{skill.length} roadmaps</span>
      </div>
      <div class="grid" id="grid-skill">
        {skill.map((rm, i) => (
          <a
            href={`/roadmap/${rm.id}`}
            class="card"
            data-id={rm.id}
            data-title={rm.title.toLowerCase()}
            data-desc={rm.description.toLowerCase()}
            style={`animation: fadeUp .4s ease both; animation-delay: ${i * 0.04}s;`}
            aria-label={`${rm.title} — ${rm.nodes.length} topics`}
            data-reveal
          >
            <div class="card-accent" style={`background: ${rm.color}`} aria-hidden="true"></div>
            <div class="card-top">
              <span class="card-icon" role="img" aria-label={`${rm.title} icon`}>{rm.icon}</span>
              <span class="card-count">{rm.nodes.length} topics</span>
            </div>
            <div class="card-title">{rm.title}</div>
            <div class="card-desc">{rm.description}</div>
            <div class="card-footer">
              <span style={`color: ${rm.color}; font-size: 0.7rem; font-weight: 600;`}>Community</span>
              <span class="card-arrow">↗</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    {other.length > 0 && (
      <>
        <div class="divider"></div>
        <section class="section" aria-labelledby="other-heading" id="section-other">
          <div class="section-head">
            <h2 class="section-title" id="other-heading">More Roadmaps</h2>
            <span class="section-count" id="other-count">{other.length} roadmaps</span>
          </div>
          <div class="grid" id="grid-other">
            {other.map((rm, i) => (
              <a
                href={`/roadmap/${rm.id}`}
                class="card"
                data-id={rm.id}
                data-title={rm.title.toLowerCase()}
                data-desc={rm.description.toLowerCase()}
                style={`animation: fadeUp .4s ease both; animation-delay: ${i * 0.04}s;`}
                aria-label={`${rm.title} — ${rm.nodes.length} topics`}
                data-reveal
              >
                <div class="card-accent" style={`background: ${rm.color}`} aria-hidden="true"></div>
                <div class="card-top">
                  <span class="card-icon">{rm.icon}</span>
                  <span class="card-count">{rm.nodes.length} topics</span>
                </div>
                <div class="card-title">{rm.title}</div>
                <div class="card-desc">{rm.description}</div>
                <div class="card-footer">
                  <span style={`color: ${rm.color}; font-size: 0.7rem; font-weight: 600;`}>Community</span>
                  <span class="card-arrow">↗</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      </>
    )}
  </div>
</main>

<!-- ── FOOTER ──────────────────────────────────────────── -->
<footer class="footer" role="contentinfo">
  <span class="footer-text">© 2026 Cosmic · All roadmaps are <a href="https://github.com/mantisdarling/cosmic">open source</a></span>
  <span class="footer-text">Built with <a href="https://astro.build">Astro</a> · <a href="https://reactflow.dev">React Flow</a> · Hosted on <a href="https://vercel.com">Vercel</a></span>
</footer>

<script>
  import { cleanAndParseJSON } from '../lib/security';

  // Scroll reveal animation observer
  const revealObserver = new IntersectionObserver(
    (entries) =>
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in');
          revealObserver.unobserve(entry.target);
        }
      }),
    { threshold: 0.05, rootMargin: '0px 0px -10px 0px' }
  );

  requestAnimationFrame(() =>
    document.querySelectorAll('[data-reveal]').forEach((element) => revealObserver.observe(element))
  );

  // Hero title text scrambling animation
  const SCRAMBLE_CHARACTERS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%&';
  const DEVELOPER_ROLES = [
    'Frontend Developers.',
    'Backend Engineers.',
    'DevOps Pros.',
    'Full-Stack Builders.',
    'AI/ML Learners.',
    'Cyber Security folks.',
    'Open Source contributors.',
  ];

  const scrambleElement = document.getElementById('scramble-text');
  let currentRoleIndex = 0;

  function runScrambleAnimation(targetText: string) {
    let iteration = 0;
    const maxIterations = targetText.length * 3;

    const scrambleInterval = setInterval(() => {
      if (!scrambleElement) return;
      scrambleElement.textContent = targetText
        .split('')
        .map((char, index) => {
          if (char === ' ') return ' ';
          if (index < Math.floor(iteration / 3)) return targetText[index];
          return SCRAMBLE_CHARACTERS[Math.floor(Math.random() * SCRAMBLE_CHARACTERS.length)];
        })
        .join('');

      iteration++;
      if (iteration > maxIterations) {
        clearInterval(scrambleInterval);
        scrambleElement.textContent = targetText;
      }
    }, 28);
  }

  setInterval(() => {
    currentRoleIndex = (currentRoleIndex + 1) % DEVELOPER_ROLES.length;
    runScrambleAnimation(DEVELOPER_ROLES[currentRoleIndex]);
  }, 3500);

  // Interactive anime energy field: particles drift upward, connect into constellations,
  // and subtly follow the pointer while the floating skill badges parallax around them.
  type HeroParticle = { x: number; y: number; radius: number; speed: number; phase: number; hue: 'cyan' | 'amber' };
  const heroContainer = document.querySelector<HTMLElement>('.hero-container');
  const particleCanvas = document.getElementById('hero-particles') as HTMLCanvasElement | null;
  const particleContext = particleCanvas?.getContext('2d');
  const floatingBadges = Array.from(document.querySelectorAll<HTMLElement>('.hero-badge'));
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (heroContainer && particleCanvas && particleContext && !prefersReducedMotion) {
    const pointer = { x: 0, y: 0, targetX: 0, targetY: 0 };
    const particles: HeroParticle[] = [];
    let canvasWidth = 0;
    let canvasHeight = 0;
    let deviceScale = 1;
    let animationFrame = 0;

    const resizeParticles = () => {
      const bounds = heroContainer.getBoundingClientRect();
      canvasWidth = bounds.width;
      canvasHeight = bounds.height;
      deviceScale = Math.min(window.devicePixelRatio || 1, 2);
      particleCanvas.width = Math.floor(canvasWidth * deviceScale);
      particleCanvas.height = Math.floor(canvasHeight * deviceScale);
      particleContext.setTransform(deviceScale, 0, 0, deviceScale, 0, 0);

      if (particles.length === 0) {
        for (let index = 0; index < 58; index += 1) {
          particles.push({
            x: Math.random() * canvasWidth,
            y: Math.random() * canvasHeight,
            radius: 0.7 + Math.random() * 1.8,
            speed: 0.08 + Math.random() * 0.22,
            phase: Math.random() * Math.PI * 2,
            hue: Math.random() > 0.76 ? 'amber' : 'cyan',
          });
        }
      }
    };

    const resetPointer = () => {
      pointer.targetX = 0;
      pointer.targetY = 0;
      heroContainer.style.setProperty('--pointer-x', '0');
      heroContainer.style.setProperty('--pointer-y', '0');
      floatingBadges.forEach((badge) => {
        badge.style.setProperty('--badge-shift-x', '0px');
        badge.style.setProperty('--badge-shift-y', '0px');
      });
    };

    const movePointer = (event: PointerEvent) => {
      const bounds = heroContainer.getBoundingClientRect();
      pointer.targetX = ((event.clientX - bounds.left) / bounds.width - 0.5) * 2;
      pointer.targetY = ((event.clientY - bounds.top) / bounds.height - 0.5) * 2;
      heroContainer.style.setProperty('--pointer-x', pointer.targetX.toFixed(3));
      heroContainer.style.setProperty('--pointer-y', pointer.targetY.toFixed(3));
      floatingBadges.forEach((badge) => {
        const depth = Number(badge.dataset.depth || 1);
        badge.style.setProperty('--badge-shift-x', `${(pointer.targetX * depth * 11).toFixed(1)}px`);
        badge.style.setProperty('--badge-shift-y', `${(pointer.targetY * depth * 8).toFixed(1)}px`);
      });
    };

    const renderParticles = (time: number) => {
      pointer.x += (pointer.targetX - pointer.x) * 0.04;
      pointer.y += (pointer.targetY - pointer.y) * 0.04;
      particleContext.clearRect(0, 0, canvasWidth, canvasHeight);
      particleContext.globalCompositeOperation = 'lighter';

      particles.forEach((particle) => {
        particle.y -= particle.speed;
        particle.x += Math.sin(time * 0.0007 + particle.phase) * 0.08;
        if (particle.y < -12) {
          particle.y = canvasHeight + 12;
          particle.x = Math.random() * canvasWidth;
        }
        const drawX = particle.x + pointer.x * particle.radius * 2.4;
        const drawY = particle.y + pointer.y * particle.radius * 1.8;
        const color = particle.hue === 'amber' ? '245,166,35' : '0,229,255';
        const glow = particleContext.createRadialGradient(drawX, drawY, 0, drawX, drawY, particle.radius * 7);
        glow.addColorStop(0, `rgba(${color},0.48)`);
        glow.addColorStop(1, `rgba(${color},0)`);
        particleContext.fillStyle = glow;
        particleContext.beginPath();
        particleContext.arc(drawX, drawY, particle.radius * 7, 0, Math.PI * 2);
        particleContext.fill();
        particleContext.fillStyle = `rgba(${color},0.9)`;
        particleContext.beginPath();
        particleContext.arc(drawX, drawY, particle.radius, 0, Math.PI * 2);
        particleContext.fill();
      });

      for (let first = 0; first < particles.length; first += 1) {
        for (let second = first + 1; second < particles.length; second += 1) {
          const a = particles[first];
          const b = particles[second];
          const ax = a.x + pointer.x * a.radius * 2.4;
          const ay = a.y + pointer.y * a.radius * 1.8;
          const bx = b.x + pointer.x * b.radius * 2.4;
          const by = b.y + pointer.y * b.radius * 1.8;
          const distance = Math.hypot(ax - bx, ay - by);
          if (distance < 92) {
            particleContext.strokeStyle = `rgba(84,188,255,${(1 - distance / 92) * 0.12})`;
            particleContext.lineWidth = 0.65;
            particleContext.beginPath();
            particleContext.moveTo(ax, ay);
            particleContext.lineTo(bx, by);
            particleContext.stroke();
          }
        }
      }

      particleContext.globalCompositeOperation = 'source-over';
      animationFrame = window.requestAnimationFrame(renderParticles);
    };

    resizeParticles();
    window.addEventListener('resize', resizeParticles);
    heroContainer.addEventListener('pointermove', movePointer, { passive: true });
    heroContainer.addEventListener('pointerleave', resetPointer, { passive: true });
    animationFrame = window.requestAnimationFrame(renderParticles);
    window.addEventListener('beforeunload', () => window.cancelAnimationFrame(animationFrame), { once: true });
  } else if (particleCanvas) {
    particleCanvas.style.display = 'none';
  }

  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const favoritesBtn = document.getElementById('favorites-filter-btn') as HTMLButtonElement;
  const searchCountElement = document.getElementById('search-count')!;
  const noResultsElement = document.getElementById('no-results')!;
  const noResultsCopyElement = document.getElementById('no-results-copy')!;
  const noResultsQueryElement = document.getElementById('no-results-query')!;
  const clearFiltersButton = document.getElementById('clear-filters') as HTMLButtonElement | null;
  const allCardElements = Array.from(document.querySelectorAll<HTMLAnchorElement>('.card'));

  let showFavoritesOnly = false;

  function getBookmarks() {
    try {
      return new Set(JSON.parse(localStorage.getItem('cosmic-bookmarks') || '[]'));
    } catch {
      return new Set();
    }
  }

  function filterRoadmaps() {
    const rawQuery = searchInput?.value || '';
    const searchQuery = rawQuery.trim().toLowerCase();
    let visibleCardCount = 0;
    const bookmarks = getBookmarks();

    allCardElements.forEach((card) => {
      const cardTitle = card.dataset.title ?? '';
      const cardDescription = card.dataset.desc ?? '';
      const cardId = card.dataset.id ?? '';
      const isSearchMatch = !searchQuery || cardTitle.includes(searchQuery) || cardDescription.includes(searchQuery);
      const isFavoriteMatch = !showFavoritesOnly || bookmarks.has(cardId);
      
      const isMatch = isSearchMatch && isFavoriteMatch;

      card.classList.toggle('hidden', !isMatch);
      if (isMatch) visibleCardCount++;
    });

    const isFiltering = Boolean(searchQuery || showFavoritesOnly);
    searchCountElement.textContent = isFiltering ? `${visibleCardCount} found` : '';
    noResultsElement.style.display = isFiltering && visibleCardCount === 0 ? 'block' : 'none';
    noResultsQueryElement.textContent = searchQuery;
    if (showFavoritesOnly && !searchQuery) {
      noResultsCopyElement.textContent = 'No favorite roadmaps yet — save a roadmap to see it here.';
    } else {
      noResultsCopyElement.textContent = `No roadmaps found for "${searchQuery}" — try a different keyword.`;
    }

    // Toggle section visibility and keep section totals accurate while filtering.
    ['role', 'skill', 'other'].forEach((sectionId) => {
      const sectionElement = document.getElementById(`section-${sectionId}`);
      if (!sectionElement) return;
      const sectionCards = Array.from(sectionElement.querySelectorAll<HTMLAnchorElement>('.card'));
      const matchingCount = sectionCards.filter((card) => !card.classList.contains('hidden')).length;
      const countElement = sectionElement.querySelector<HTMLElement>('.section-count');
      if (countElement) countElement.textContent = isFiltering ? `${matchingCount} of ${sectionCards.length}` : `${sectionCards.length} roadmaps`;
      sectionElement.style.display = matchingCount > 0 ? '' : 'none';
    });
  }

  if (searchInput) {
    searchInput.addEventListener('input', () => filterRoadmaps());
    searchInput.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        searchInput.value = '';
        filterRoadmaps();
        searchInput.blur();
      }
    });

    // Global shortcut to focus search
    window.addEventListener('keydown', (event) => {
      if (event.key === '/' && document.activeElement !== searchInput && document.activeElement !== document.getElementById('ai-topic-input')) {
        event.preventDefault();
        searchInput.focus();
      }
    });

    // ── AI GENERATOR LOGIC ──────────────────────────────────────────
    const aiBtn = document.getElementById('ai-generate-btn');
    const aiPanel = document.getElementById('ai-generator-panel');
    const aiForm = document.getElementById('ai-generate-form');
    const aiInput = document.getElementById('ai-topic-input') as HTMLInputElement | null;
    const aiSubmitBtn = document.getElementById('ai-submit-btn') as HTMLButtonElement | null;
    const aiLoading = document.getElementById('ai-loading');
    const aiError = document.getElementById('ai-error');

    if (aiBtn && aiPanel && aiForm && aiInput && aiSubmitBtn && aiLoading && aiError) {
      aiBtn.addEventListener('click', () => {
        const isHidden = aiPanel.style.display === 'none';
        aiPanel.style.display = isHidden ? 'block' : 'none';
        if (isHidden) aiInput.focus();
      });

      aiForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const topic = aiInput.value.trim();
        if (!topic) return;

        aiSubmitBtn.disabled = true;
        aiSubmitBtn.style.opacity = '0.6';
        aiLoading.style.display = 'flex';
        aiError.style.display = 'none';

        try {
          const response = await fetch('/api/ai', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ topic, action: 'generate' }),
          });
          const data = await response.json();
          if (!response.ok || data.error) {
            throw new Error(data.error ?? 'Generation failed.');
          }

          const parsed = cleanAndParseJSON(data.text);
          sessionStorage.setItem('custom_roadmap_data', JSON.stringify(parsed));
          window.location.href = '/roadmap/custom';
        } catch (err) {
          const msg = err instanceof Error ? err.message : 'Failed to parse AI response. Please try another topic.';
          aiError.textContent = msg;
          aiError.style.display = 'block';
          aiSubmitBtn.disabled = false;
          aiSubmitBtn.style.opacity = '1';
          aiLoading.style.display = 'none';
        }
      });
    }
  }
  
  if (favoritesBtn) {
    favoritesBtn.addEventListener('click', () => {
      showFavoritesOnly = !showFavoritesOnly;
      favoritesBtn.classList.toggle('active', showFavoritesOnly);
      favoritesBtn.setAttribute('aria-pressed', String(showFavoritesOnly));
      filterRoadmaps();
    });
  }

  clearFiltersButton?.addEventListener('click', () => {
    searchInput.value = '';
    showFavoritesOnly = false;
    favoritesBtn?.classList.remove('active');
    favoritesBtn?.setAttribute('aria-pressed', 'false');
    filterRoadmaps();
    searchInput.focus();
  });

  window.addEventListener('cosmic-bookmarks-updated', filterRoadmaps);
</script>

</BaseLayout>
