---
/**
 * Nav.astro — Top navigation bar
 * Uses scoped <style> so rendering doesn't depend on Tailwind scanning.
 */
---

<style>
  nav.cosmic-nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 28px;
    height: 64px;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    background: rgba(8, 8, 16, 0.82);
    border-bottom: 1px solid rgba(255,255,255,0.06);
    transition: box-shadow 0.3s ease;
  }
  nav.cosmic-nav.scrolled {
    box-shadow: 0 4px 32px rgba(0,0,0,0.5);
  }
  .nav-logo {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.4rem;
    letter-spacing: 0.2em;
    color: #f0f0ff;
    text-decoration: none;
    transition: color 0.2s;
  }
  .nav-logo:hover { color: #a78bfa; }

  .nav-links {
    display: none;
    align-items: center;
    gap: 36px;
    list-style: none;
    margin: 0; padding: 0;
  }
  @media (min-width: 768px) {
    .nav-links { display: flex; }
  }
  .nav-links a {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #6060a0;
    text-decoration: none;
    transition: color 0.2s;
  }
  .nav-links a:hover { color: #f0f0ff; }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .theme-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.1);
    background: rgba(255,255,255,0.04);
    color: #6060a0;
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }
  .theme-btn:hover {
    border-color: #7c3aed;
    color: #a78bfa;
    background: rgba(124,58,237,0.08);
  }

  /* Mobile hamburger */
  .hamburger {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 8px;
    background: none;
    border: none;
    cursor: pointer;
  }
  @media (min-width: 768px) { .hamburger { display: none; } }
  .hamburger-line {
    display: block;
    height: 1.5px;
    background: #6060a0;
    border-radius: 2px;
    transition: all 0.25s;
  }
  .hamburger-line:nth-child(1) { width: 20px; }
  .hamburger-line:nth-child(2) { width: 20px; }
  .hamburger-line:nth-child(3) { width: 12px; }
  .hamburger:hover .hamburger-line { background: #a78bfa; }

  /* Mobile menu */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 40;
  }
  .mobile-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.7);
    backdrop-filter: blur(4px);
  }
  .mobile-drawer {
    position: absolute;
    top: 0; right: 0; bottom: 0;
    width: 280px;
    background: #12121e;
    border-left: 1px solid #1e1e35;
    display: flex;
    flex-direction: column;
    padding: 80px 32px 32px;
    gap: 32px;
  }
  .mobile-drawer a {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2.5rem;
    letter-spacing: 0.08em;
    color: #f0f0ff;
    text-decoration: none;
    transition: color 0.2s;
  }
  .mobile-drawer a:hover { color: #a78bfa; }
</style>

<nav id="mainNav" class="cosmic-nav" role="navigation" aria-label="Main navigation">
  <!-- Logo -->
  <a href="/" class="nav-logo" aria-label="Cosmic Roadmap home">COSMIC</a>

  <!-- Desktop links -->
  <ul class="nav-links" role="list">
    <li><a href="/">Roadmaps</a></li>
    <li><a href="/#about">About</a></li>
  </ul>

  <!-- Right -->
  <div class="nav-right">
    <button id="themeToggle" class="theme-btn" aria-label="Toggle light/dark theme">
      <span id="themeIcon" aria-hidden="true">◐</span>
      <span id="themeLabel">Light</span>
    </button>
    <button
      id="mobileMenuBtn"
      class="hamburger"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mobileMenu"
    >
      <span class="hamburger-line" aria-hidden="true"></span>
      <span class="hamburger-line" aria-hidden="true"></span>
      <span class="hamburger-line" aria-hidden="true"></span>
    </button>
  </div>
</nav>

<!-- Mobile menu -->
<div id="mobileMenu" role="dialog" aria-label="Mobile navigation" aria-modal="true" hidden class="mobile-menu">
  <div id="mobileBackdrop" class="mobile-backdrop" aria-hidden="true"></div>
  <nav class="mobile-drawer">
    <a href="/">Roadmaps</a>
    <a href="/#about">About</a>
  </nav>
</div>

<script>
  const THEMES = ['dark', 'light'] as const;
  type Theme = typeof THEMES[number];

  function getTheme(): Theme {
    const s = localStorage.getItem('cosmic-theme');
    return (THEMES as readonly string[]).includes(s ?? '') ? s as Theme : 'dark';
  }
  function applyTheme(t: Theme) {
    document.documentElement.setAttribute('data-theme', t);
    document.documentElement.classList.toggle('dark', t === 'dark');
    const lbl = document.getElementById('themeLabel');
    const ico = document.getElementById('themeIcon');
    if (lbl) lbl.textContent = t === 'dark' ? 'Light' : 'Dark';
    if (ico) ico.textContent = t === 'dark' ? '◐' : '◑';
    localStorage.setItem('cosmic-theme', t);
  }

  document.getElementById('themeToggle')?.addEventListener('click', () => {
    applyTheme(getTheme() === 'dark' ? 'light' : 'dark');
  });
  applyTheme(getTheme());

  // Mobile menu
  const btn = document.getElementById('mobileMenuBtn');
  const menu = document.getElementById('mobileMenu');
  const backdrop = document.getElementById('mobileBackdrop');

  function openMenu() {
    menu?.removeAttribute('hidden');
    btn?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }
  function closeMenu() {
    menu?.setAttribute('hidden', '');
    btn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  btn?.addEventListener('click', () => {
    btn.getAttribute('aria-expanded') === 'true' ? closeMenu() : openMenu();
  });
  backdrop?.addEventListener('click', closeMenu);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeMenu(); });
  menu?.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));

  // Scroll shadow
  const nav = document.getElementById('mainNav');
  window.addEventListener('scroll', () => {
    nav?.classList.toggle('scrolled', window.scrollY > 20);
  }, { passive: true });
</script>
