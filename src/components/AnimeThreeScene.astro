<div class="anime-three-scene" data-anime-three-scene aria-hidden="true">
  <canvas class="anime-three-canvas" id="anime-three-canvas"></canvas>
</div>

<style>
  .anime-three-scene {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
    opacity: .78;
    mix-blend-mode: screen;
    contain: strict;
  }

  .anime-three-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (pointer: coarse), (max-width: 820px) {
    .anime-three-scene { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .anime-three-scene { display: none; }
  }
</style>

<script>
  type ThreeModule = typeof import('three');
  type IdleWindow = Window & { requestIdleCallback?: (callback: () => void, options?: { timeout: number }) => number };

  const root = document.querySelector<HTMLElement>('[data-anime-three-scene]');
  const canvas = document.getElementById('anime-three-canvas') as HTMLCanvasElement | null;
  const hero = document.querySelector<HTMLElement>('.hero-container');
  const motionMedia = window.matchMedia('(prefers-reduced-motion: reduce)');
  const finePointer = window.matchMedia('(pointer: fine)').matches;
  const canAffordMotion = !motionMedia.matches && finePointer && (navigator.hardwareConcurrency || 8) > 4;

  if (root && canvas && hero && canAffordMotion) {
    const idleWindow = window as IdleWindow;
    const schedule = idleWindow.requestIdleCallback
      ? (callback: () => void) => idleWindow.requestIdleCallback?.(callback, { timeout: 420 })
      : (callback: () => void) => window.setTimeout(callback, 140);

    schedule(async () => {
      let THREE: ThreeModule;
      try {
        THREE = await import('three');
      } catch {
        root.remove();
        return;
      }

      let renderer: InstanceType<ThreeModule['WebGLRenderer']>;
      try {
        renderer = new THREE.WebGLRenderer({
          canvas,
          alpha: true,
          antialias: false,
          powerPreference: 'high-performance',
          premultipliedAlpha: true,
        });
      } catch {
        root.remove();
        return;
      }

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(28, 1, .1, 100);
      camera.position.set(0, .05, 7.2);
      camera.lookAt(0, 0, 0);

      const stage = new THREE.Group();
      stage.position.x = .78;
      stage.position.y = .08;
      scene.add(stage);

      const orbitalField = new THREE.Group();
      stage.add(orbitalField);

      const cyan = new THREE.Color('#00E5FF');
      const amber = new THREE.Color('#F5A623');
      const violet = new THREE.Color('#A78BFA');
      const shardGeometry = new THREE.OctahedronGeometry(.11, 0);
      const shardMaterials = [
        new THREE.MeshBasicMaterial({ color: cyan, transparent: true, opacity: .62 }),
        new THREE.MeshBasicMaterial({ color: amber, transparent: true, opacity: .58 }),
        new THREE.MeshBasicMaterial({ color: violet, transparent: true, opacity: .52 }),
      ];

      type Shard = { mesh: InstanceType<ThreeModule['Mesh']>; angle: number; radius: number; height: number; speed: number; phase: number; baseScale: number; offsetX: number; offsetY: number; offsetZ: number; velocityX: number; velocityY: number; velocityZ: number; dragX: number; dragY: number; dragZ: number };
      const shards: Shard[] = [];
      for (let index = 0; index < 18; index += 1) {
        const angle = (index / 18) * Math.PI * 2;
        const radius = 1.18 + (index % 4) * .18;
        const mesh = new THREE.Mesh(shardGeometry, shardMaterials[index % shardMaterials.length]);
        mesh.position.set(Math.cos(angle) * radius, Math.sin(angle) * (.68 + (index % 3) * .1), -1.1 + (index % 5) * .32);
        mesh.rotation.set(angle * .7, angle, angle * .35);
        const baseScale = .7 + (index % 3) * .14;
        mesh.scale.setScalar(baseScale);
        orbitalField.add(mesh);
        shards.push({ mesh, angle, radius, height: .68 + (index % 3) * .1, speed: .12 + (index % 5) * .018, phase: index * .47, baseScale, offsetX: 0, offsetY: 0, offsetZ: 0, velocityX: 0, velocityY: 0, velocityZ: 0, dragX: mesh.position.x, dragY: mesh.position.y, dragZ: mesh.position.z });
      }

      const ringGeometry = new THREE.TorusGeometry(1.36, .012, 6, 64);
      const cyanRing = new THREE.Mesh(ringGeometry, new THREE.MeshBasicMaterial({ color: cyan, transparent: true, opacity: .32 }));
      cyanRing.rotation.set(.84, -.24, -.52);
      stage.add(cyanRing);
      const amberRing = new THREE.Mesh(new THREE.TorusGeometry(1.72, .009, 6, 64), new THREE.MeshBasicMaterial({ color: amber, transparent: true, opacity: .24 }));
      amberRing.rotation.set(-.46, .72, .3);
      stage.add(amberRing);

      const core = new THREE.Mesh(new THREE.IcosahedronGeometry(.34, 1), new THREE.MeshBasicMaterial({ color: cyan, transparent: true, opacity: .14, wireframe: true }));
      stage.add(core);
      const coreHalo = new THREE.Mesh(new THREE.SphereGeometry(.56, 16, 16), new THREE.MeshBasicMaterial({ color: cyan, transparent: true, opacity: .055 }));
      stage.add(coreHalo);
      const impactRingGeometry = new THREE.TorusGeometry(.24, .016, 6, 48);
      const impactRingMaterial = new THREE.MeshBasicMaterial({ color: cyan, transparent: true, opacity: 0, depthWrite: false });
      const impactRing = new THREE.Mesh(impactRingGeometry, impactRingMaterial);
      impactRing.rotation.x = .86;
      impactRing.visible = false;
      stage.add(impactRing);
      const burstCount = 42;
      const burstPositions = new Float32Array(burstCount * 3);
      const burstColors = new Float32Array(burstCount * 3);
      const burstGeometry = new THREE.BufferGeometry();
      burstGeometry.setAttribute('position', new THREE.BufferAttribute(burstPositions, 3));
      burstGeometry.setAttribute('color', new THREE.BufferAttribute(burstColors, 3));
      const burstMaterial = new THREE.PointsMaterial({ size: .055, vertexColors: true, transparent: true, opacity: 0, depthWrite: false, blending: THREE.AdditiveBlending, sizeAttenuation: true });
      const burstParticles = new THREE.Points(burstGeometry, burstMaterial);
      stage.add(burstParticles);
      const burstVelocities = Array.from({ length: burstCount }, () => new THREE.Vector3());
      const burstLifetimes = new Float32Array(burstCount);

      const resize = () => {
        const bounds = root.getBoundingClientRect();
        const width = Math.max(1, bounds.width);
        const height = Math.max(1, bounds.height);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.25));
        renderer.setSize(width, height, false);
        camera.aspect = width / height;
        camera.updateProjectionMatrix();
      };

      let targetX = 0;
      let targetY = 0;
      let springX = 0;
      let springY = 0;
      let velocityX = 0;
      let velocityY = 0;
      let frame = 0;
      let visible = true;
      let lastTime = performance.now();
      let impactEnergy = 0;
      let impactCooldown = 0;
      let impactCount = 0;
      let throwCount = 0;
      let grabbedShard: Shard | null = null;
      let dragPointerId: number | null = null;
      let dragMoved = false;
      let lastDragX = 0;
      let lastDragY = 0;
      let audioContext: AudioContext | null = null;
      const impactPoint = new THREE.Vector3();
      const dragPoint = new THREE.Vector3();
      const dragOffset = new THREE.Vector3();
      const shardScreenPoint = new THREE.Vector3();
      const raycaster = new THREE.Raycaster();
      const pointer = new THREE.Vector2();
      const impactPlane = new THREE.Plane(new THREE.Vector3(0, 0, 1), 0);

      const playCue = (type: 'grab' | 'throw' | 'burst') => {
        try {
          audioContext ??= new AudioContext();
          if (audioContext.state === 'suspended') void audioContext.resume();
          const oscillator = audioContext.createOscillator();
          const gain = audioContext.createGain();
          const now = audioContext.currentTime;
          const frequency = type === 'throw' ? 210 : type === 'burst' ? 420 : 300;
          oscillator.type = type === 'burst' ? 'triangle' : 'sine';
          oscillator.frequency.setValueAtTime(frequency, now);
          oscillator.frequency.exponentialRampToValueAtTime(frequency * (type === 'throw' ? 1.55 : .72), now + .12);
          gain.gain.setValueAtTime(.0001, now);
          gain.gain.exponentialRampToValueAtTime(type === 'burst' ? .045 : .028, now + .012);
          gain.gain.exponentialRampToValueAtTime(.0001, now + .14);
          oscillator.connect(gain).connect(audioContext.destination);
          oscillator.start(now);
          oscillator.stop(now + .16);
        } catch { /* Audio is an enhancement and may be unavailable. */ }
      };

      const emitBurst = (point: InstanceType<ThreeModule['Vector3']>, color: InstanceType<ThreeModule['Color']>, strength = 1) => {
        const rgb = color.toArray();
        for (let index = 0; index < burstCount; index += 1) {
          const offset = index * 3;
          const theta = (index / burstCount) * Math.PI * 2 + Math.random() * .6;
          const spread = .02 + Math.random() * .05;
          burstPositions[offset] = point.x;
          burstPositions[offset + 1] = point.y;
          burstPositions[offset + 2] = point.z;
          burstVelocities[index].set(Math.cos(theta) * spread * strength, Math.sin(theta) * spread * strength, (Math.random() - .5) * .055 * strength);
          burstLifetimes[index] = .72 + Math.random() * .35;
          burstColors[offset] = rgb[0] ?? 1;
          burstColors[offset + 1] = rgb[1] ?? 1;
          burstColors[offset + 2] = rgb[2] ?? 1;
        }
        burstGeometry.attributes.position.needsUpdate = true;
        burstGeometry.attributes.color.needsUpdate = true;
        burstMaterial.opacity = .92;
        root.dataset.burstCount = String((Number(root.dataset.burstCount) || 0) + 1);
        playCue('burst');
      };

      const updatePointerTarget = (event: PointerEvent) => {
        const bounds = hero.getBoundingClientRect();
        targetX = ((event.clientX - bounds.left) / bounds.width - .5) * 2;
        targetY = ((event.clientY - bounds.top) / bounds.height - .5) * 2;
      };
      const handlePointerMove = (event: PointerEvent) => {
        updatePointerTarget(event);
        if (!grabbedShard || dragPointerId !== event.pointerId) return;
        const bounds = hero.getBoundingClientRect();
        pointer.set(((event.clientX - bounds.left) / bounds.width) * 2 - 1, -(((event.clientY - bounds.top) / bounds.height) * 2 - 1));
        raycaster.setFromCamera(pointer, camera);
        if (!raycaster.ray.intersectPlane(impactPlane, dragPoint)) return;
        stage.worldToLocal(dragPoint);
        dragPoint.add(dragOffset);
        const deltaX = dragPoint.x - lastDragX;
        const deltaY = dragPoint.y - lastDragY;
        grabbedShard.dragX = dragPoint.x;
        grabbedShard.dragY = dragPoint.y;
        grabbedShard.dragZ = dragPoint.z - .12;
        grabbedShard.velocityX = deltaX * 1.35;
        grabbedShard.velocityY = deltaY * 1.35;
        grabbedShard.velocityZ = -.02;
        lastDragX = dragPoint.x;
        lastDragY = dragPoint.y;
        dragMoved ||= Math.abs(deltaX) + Math.abs(deltaY) > .018;
        root.dataset.grabbed = 'true';
      };
      const resetPointer = () => { targetX = 0; targetY = 0; };
      const handlePointerDown = (event: PointerEvent) => {
        if (event.button !== 0 || impactCooldown > 0) return;
        if (event.target instanceof Element && event.target.closest('a,button,input,select,textarea')) return;
        const bounds = hero.getBoundingClientRect();
        pointer.set(((event.clientX - bounds.left) / bounds.width) * 2 - 1, -(((event.clientY - bounds.top) / bounds.height) * 2 - 1));
        raycaster.setFromCamera(pointer, camera);
        const hit = raycaster.intersectObjects(shards.map((shard) => shard.mesh), false)[0];
        if (hit) {
          grabbedShard = shards.find((shard) => shard.mesh === hit.object) ?? null;
          if (grabbedShard && raycaster.ray.intersectPlane(impactPlane, dragPoint)) {
            stage.worldToLocal(dragPoint);
            dragOffset.copy(grabbedShard.mesh.position).sub(dragPoint);
            grabbedShard.dragX = grabbedShard.mesh.position.x;
            grabbedShard.dragY = grabbedShard.mesh.position.y;
            grabbedShard.dragZ = grabbedShard.mesh.position.z;
            lastDragX = grabbedShard.mesh.position.x;
            lastDragY = grabbedShard.mesh.position.y;
            dragMoved = false;
            dragPointerId = event.pointerId;
            hero.setPointerCapture?.(event.pointerId);
            grabbedShard.velocityX = 0;
            grabbedShard.velocityY = 0;
            grabbedShard.velocityZ = 0;
            root.dataset.grabbed = 'true';
            emitBurst(grabbedShard.mesh.position, shardMaterials[shards.indexOf(grabbedShard) % shardMaterials.length].color, .7);
            playCue('grab');
          }
          return;
        }
        if (!raycaster.ray.intersectPlane(impactPlane, impactPoint)) return;
        stage.worldToLocal(impactPoint);
        impactEnergy = Math.min(1.2, impactEnergy + .82);
        impactCooldown = .08;
        impactCount += 1;
        root.dataset.impactCount = String(impactCount);
        root.dataset.impactActive = 'true';
        impactRing.position.copy(impactPoint);
        impactRing.scale.setScalar(.22);
        impactRingMaterial.opacity = .88;
        impactRing.visible = true;
        emitBurst(impactPoint, cyan, .82);
        shards.forEach((shard) => {
          const orbitAngle = shard.angle + performance.now() * .001 * shard.speed;
          const baseX = Math.cos(orbitAngle) * shard.radius;
          const baseY = Math.sin(orbitAngle * 1.07 + shard.phase) * shard.height;
          const dx = baseX - impactPoint.x;
          const dy = baseY - impactPoint.y;
          const distance = Math.hypot(dx, dy);
          const influence = Math.max(0, 1 - distance / 2.55);
          if (!influence) return;
          const inverseDistance = distance > .08 ? 1 / distance : 0;
          const push = (.16 + influence * .16) * impactEnergy;
          shard.velocityX += (dx * inverseDistance || Math.cos(shard.angle)) * push;
          shard.velocityY += (dy * inverseDistance || Math.sin(shard.angle)) * push;
          shard.velocityZ += (.08 + influence * .08) * impactEnergy;
        });
        if (!frame && visible) frame = window.requestAnimationFrame(render);
      };
      const handlePointerUp = (event: PointerEvent) => {
        if (!grabbedShard || dragPointerId !== event.pointerId) return;
        const shard = grabbedShard;
        const throwX = Math.max(-.34, Math.min(.34, shard.velocityX * (dragMoved ? 1.8 : .4)));
        const throwY = Math.max(-.34, Math.min(.34, shard.velocityY * (dragMoved ? 1.8 : .4)));
        const releaseTime = performance.now() * .001;
        const releaseOrbitAngle = shard.angle + releaseTime * shard.speed;
        const releaseBaseX = Math.cos(releaseOrbitAngle) * shard.radius;
        const releaseBaseY = Math.sin(releaseOrbitAngle * 1.07 + shard.phase) * shard.height;
        const releaseBaseZ = -1.1 + Math.sin(releaseTime * .7 + shard.phase) * .28 + (shard.angle % .9);
        shard.offsetX = shard.mesh.position.x - releaseBaseX;
        shard.offsetY = shard.mesh.position.y - releaseBaseY;
        shard.offsetZ = shard.mesh.position.z - releaseBaseZ;
        shard.velocityX = throwX;
        shard.velocityY = throwY;
        shard.velocityZ = Math.max(.04, Math.min(.22, Math.abs(shard.velocityZ) + (dragMoved ? .08 : .04)));
        if (dragMoved) {
          throwCount += 1;
          root.dataset.throwCount = String(throwCount);
          emitBurst(shard.mesh.position, shardMaterials[shards.indexOf(shard) % shardMaterials.length].color, 1.2);
          playCue('throw');
        }
        root.dataset.grabbed = 'false';
        grabbedShard = null;
        dragPointerId = null;
        dragMoved = false;
        hero.releasePointerCapture?.(event.pointerId);
      };
      const render = (now: number) => {
        frame = 0;
        if (!visible) return;
        const elapsed = Math.min(48, now - lastTime);
        lastTime = now;
        const time = now * .001;
        const delta = elapsed / 16.67;
        impactCooldown = Math.max(0, impactCooldown - elapsed * .001);
        impactEnergy = Math.max(0, impactEnergy * Math.pow(.87, delta));
        impactRing.scale.multiplyScalar(Math.pow(.94, delta));
        impactRingMaterial.opacity *= Math.pow(.82, delta);
        if (impactRingMaterial.opacity < .015) {
          impactRing.visible = false;
          root.dataset.impactActive = 'false';
        }
        let activeBursts = 0;
        for (let index = 0; index < burstCount; index += 1) {
          if (burstLifetimes[index] <= 0) continue;
          const offset = index * 3;
          const velocity = burstVelocities[index];
          burstPositions[offset] += velocity.x * delta;
          burstPositions[offset + 1] += velocity.y * delta;
          burstPositions[offset + 2] += velocity.z * delta;
          velocity.multiplyScalar(Math.pow(.93, delta));
          burstLifetimes[index] -= .024 * delta;
          activeBursts += 1;
        }
        burstMaterial.opacity = activeBursts ? Math.min(.92, activeBursts / burstCount) : 0;
        burstGeometry.attributes.position.needsUpdate = activeBursts > 0;
        velocityX += (targetX - springX) * .028 * delta;
        velocityY += (targetY - springY) * .028 * delta;
        velocityX *= Math.pow(.78, delta);
        velocityY *= Math.pow(.78, delta);
        springX += velocityX * delta;
        springY += velocityY * delta;

        stage.rotation.y = springX * .11 + Math.sin(time * .24) * .018;
        stage.rotation.x = springY * .06 + Math.cos(time * .2) * .012;
        stage.position.x = .78 + springX * .22;
        stage.position.y = .08 - springY * .12;
        orbitalField.rotation.z += .0008 * delta;
        cyanRing.rotation.z += .0012 * delta;
        amberRing.rotation.z -= .0007 * delta;
        core.rotation.x += .003 * delta;
        core.rotation.y -= .004 * delta;
        core.scale.setScalar(1 + Math.sin(time * 1.35) * .08 + impactEnergy * .18);
        coreHalo.scale.setScalar(1 + Math.sin(time * .9 + 1.4) * .12 + impactEnergy * .3);

        shards.forEach((shard) => {
          const { mesh, angle, radius, height, speed, phase, baseScale } = shard;
          const orbitAngle = angle + time * speed;
          const baseX = Math.cos(orbitAngle) * radius;
          const baseY = Math.sin(orbitAngle * 1.07 + phase) * height;
          const baseZ = -1.1 + Math.sin(time * .7 + phase) * .28 + (angle % .9);
          if (shard === grabbedShard) {
            mesh.position.set(shard.dragX, shard.dragY, shard.dragZ);
            shard.velocityX *= Math.pow(.72, delta);
            shard.velocityY *= Math.pow(.72, delta);
            shard.velocityZ *= Math.pow(.72, delta);
          } else {
            shard.velocityX += -shard.offsetX * .024 * delta;
            shard.velocityY += -shard.offsetY * .024 * delta;
            shard.velocityZ += -shard.offsetZ * .024 * delta;
          }
          shard.velocityX *= Math.pow(.84, delta);
          shard.velocityY *= Math.pow(.84, delta);
          shard.velocityZ *= Math.pow(.84, delta);
          if (shard !== grabbedShard) {
            shard.offsetX += shard.velocityX * delta;
            shard.offsetY += shard.velocityY * delta;
            shard.offsetZ += shard.velocityZ * delta;
            mesh.position.set(baseX + shard.offsetX, baseY + shard.offsetY, baseZ + shard.offsetZ);
          }
          const impactScale = 1 + Math.min(.42, Math.hypot(shard.offsetX, shard.offsetY, shard.offsetZ) * .22);
          mesh.scale.setScalar(baseScale * impactScale);
          mesh.rotation.x += (.006 + Math.abs(shard.velocityY) * .012) * delta;
          mesh.rotation.y += (.009 + Math.abs(shard.velocityX) * .012) * delta;
          if (shard === shards[0]) {
            const projected = mesh.getWorldPosition(shardScreenPoint).project(camera);
            const bounds = root.getBoundingClientRect();
            root.dataset.shardPoint = `${bounds.left + (projected.x + 1) * bounds.width * .5},${bounds.top + (1 - projected.y) * bounds.height * .5}`;
          }
        });

        renderer.render(scene, camera);
        frame = window.requestAnimationFrame(render);
      };

      const setVisible = (nextVisible: boolean) => {
        visible = nextVisible;
        if (visible && !frame) {
          lastTime = performance.now();
          frame = window.requestAnimationFrame(render);
        }
      };

      const observer = new IntersectionObserver(([entry]) => setVisible(Boolean(entry?.isIntersecting)), { threshold: .01 });
      observer.observe(hero);
      const handleDocumentVisibility = () => {
        if (document.hidden) {
          if (frame) window.cancelAnimationFrame(frame);
          frame = 0;
          visible = false;
        } else {
          visible = true;
          if (!frame) frame = window.requestAnimationFrame(render);
        }
      };

      resize();
      hero.addEventListener('pointermove', handlePointerMove, { passive: true });
      hero.addEventListener('pointerleave', resetPointer, { passive: true });
      hero.addEventListener('pointerdown', handlePointerDown, { passive: true });
      hero.addEventListener('pointerup', handlePointerUp, { passive: true });
      hero.addEventListener('pointercancel', handlePointerUp, { passive: true });
      window.addEventListener('resize', resize, { passive: true });
      document.addEventListener('visibilitychange', handleDocumentVisibility, { passive: true });
      window.addEventListener('beforeunload', () => {
        observer.disconnect();
        hero.removeEventListener('pointermove', handlePointerMove);
        hero.removeEventListener('pointerleave', resetPointer);
        hero.removeEventListener('pointerdown', handlePointerDown);
        hero.removeEventListener('pointerup', handlePointerUp);
        hero.removeEventListener('pointercancel', handlePointerUp);
        window.removeEventListener('resize', resize);
        document.removeEventListener('visibilitychange', handleDocumentVisibility);
        if (frame) window.cancelAnimationFrame(frame);
        renderer.dispose();
        shardGeometry.dispose();
        shardMaterials.forEach((material) => material.dispose());
        ringGeometry.dispose();
        impactRingGeometry.dispose();
        impactRingMaterial.dispose();
        burstGeometry.dispose();
        burstMaterial.dispose();
        amberRing.geometry.dispose();
        (amberRing.material as InstanceType<ThreeModule['MeshBasicMaterial']>).dispose();
        (core.geometry as InstanceType<ThreeModule['IcosahedronGeometry']>).dispose();
        (core.material as InstanceType<ThreeModule['MeshBasicMaterial']>).dispose();
        (coreHalo.geometry as InstanceType<ThreeModule['SphereGeometry']>).dispose();
        (coreHalo.material as InstanceType<ThreeModule['MeshBasicMaterial']>).dispose();
      }, { once: true });

      frame = window.requestAnimationFrame(render);
    });
  }
</script>
