<section class="arena-section" aria-labelledby="arena-heading">
  <div class="arena-section-head">
    <div>
      <div class="arena-kicker">Training simulation // 002</div>
      <h2 id="arena-heading">Stormblade: Lightning Trial</h2>
      <p>Test the Stormblade’s lightning abilities, survive the incoming arc-wraiths, and build your combo.</p>
    </div>
    <div class="arena-shortcut">WASD / arrows to move · 1 2 3 to cast</div>
  </div>

  <div class="arena-shell" data-stormblade-arena>
    <div class="arena-visual" id="stormblade-arena" tabindex="0" role="application" aria-label="Stormblade lightning battle arena">
      <canvas id="stormblade-canvas"></canvas>
      <div class="arena-grid-glow" aria-hidden="true"></div>
      <div class="arena-hud arena-hud-top">
        <div class="arena-stat"><span>HP</span><div class="arena-meter"><i id="arena-health-bar"></i></div><strong id="arena-health-value">100</strong></div>
        <div class="arena-stat"><span>ENERGY</span><div class="arena-meter energy"><i id="arena-energy-bar"></i></div><strong id="arena-energy-value">100</strong></div>
        <div class="arena-score"><span>COMBO</span><strong id="arena-score-value">00</strong></div>
      </div>
      <div class="arena-center-status" id="arena-status" role="status">Press launch to enter the trial</div>
      <div class="arena-hud arena-hud-bottom">
        <div class="arena-abilities" aria-label="Stormblade abilities">
          <button type="button" class="arena-ability" data-ability="dash" aria-label="Cast Thunder Dash, keyboard 1"><b>1</b><span>Thunder Dash</span><small>25 EN</small></button>
          <button type="button" class="arena-ability" data-ability="arc" aria-label="Cast Lightning Arc, keyboard 2"><b>2</b><span>Lightning Arc</span><small>35 EN</small></button>
          <button type="button" class="arena-ability" data-ability="pulse" aria-label="Cast Storm Pulse, keyboard 3"><b>3</b><span>Storm Pulse</span><small>50 EN</small></button>
        </div>
        <button type="button" class="arena-launch" id="arena-launch">Launch trial</button>
      </div>
    </div>
    <aside class="arena-brief" aria-label="Stormblade trial instructions">
      <div class="arena-brief-label">Mission brief</div>
      <h3>Break the arc-wraiths.</h3>
      <p>Move through the arena and cast your three abilities before the swarm closes in. Every hit restores a little energy; every miss costs time.</p>
      <div class="arena-objectives">
        <div><span class="objective-dot cyan"></span><span>Survive the wave</span><strong id="arena-wave-value">01</strong></div>
        <div><span class="objective-dot amber"></span><span>Defeat targets</span><strong id="arena-defeated-value">00</strong></div>
        <div><span class="objective-dot violet"></span><span>Best combo</span><strong id="arena-best-value">00</strong></div>
      </div>
      <p class="arena-hint">Tip: Thunder Dash is your fastest escape. Storm Pulse clears a crowded field.</p>
    </aside>
  </div>
</section>

<style>
  .arena-section { max-width: 1200px; margin: 0 auto; padding: 28px 24px 54px; }
  .arena-section-head { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 18px; }
  .arena-section-head h2 { margin: 8px 0 8px; color: #F5F5F5; font-size: clamp(1.35rem, 2.5vw, 2rem); letter-spacing: -.045em; }
  .arena-section-head p { max-width: 620px; margin: 0; color: #8992A8; font-size: .82rem; line-height: 1.6; }
  .arena-kicker, .arena-brief-label { color: #00E5FF; font: 700 .66rem/1 'Space Mono', monospace; letter-spacing: .1em; text-transform: uppercase; }
  .arena-shortcut { color: #69758E; font: 600 .64rem/1.4 'Space Mono', monospace; text-align: right; text-transform: uppercase; }
  .arena-shell { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(240px, .45fr); gap: 12px; }
  .arena-visual { position: relative; min-height: 450px; overflow: hidden; border: 1px solid rgba(0,229,255,.28); border-radius: 18px; background: linear-gradient(90deg, rgba(6,10,22,.96), rgba(6,10,22,.72)), url('/cosmic-anime-hero.webp') center / cover; box-shadow: 0 22px 60px rgba(0,0,0,.35), inset 0 0 60px rgba(0,229,255,.08); outline: none; }
  .arena-visual:focus-visible { box-shadow: 0 0 0 3px rgba(252,208,104,.32), 0 22px 60px rgba(0,0,0,.35); }
  #stormblade-canvas { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
  .arena-grid-glow { position: absolute; inset: 0; pointer-events: none; background-image: linear-gradient(rgba(0,229,255,.035) 1px, transparent 1px), linear-gradient(90deg, rgba(0,229,255,.035) 1px, transparent 1px); background-size: 42px 42px; mask-image: linear-gradient(180deg, transparent, #000 30%, #000 75%, transparent); }
  .arena-hud { position: absolute; left: 20px; right: 20px; display: flex; align-items: center; gap: 18px; z-index: 3; pointer-events: none; }
  .arena-hud-top { top: 18px; }
  .arena-hud-bottom { bottom: 18px; justify-content: space-between; align-items: end; pointer-events: auto; }
  .arena-stat { display: grid; grid-template-columns: auto minmax(100px, 190px) auto; align-items: center; gap: 8px; color: #A8B0C2; font: 700 .62rem/1 'Space Mono', monospace; }
  .arena-stat strong { color: #F5F5F5; font-size: .7rem; }
  .arena-meter { height: 6px; overflow: hidden; border-radius: 99px; background: rgba(255,255,255,.12); }
  .arena-meter i { display: block; width: 100%; height: 100%; border-radius: inherit; background: linear-gradient(90deg, #EF476F, #F5A623); transition: width .2s; }
  .arena-meter.energy i { background: linear-gradient(90deg, #00E5FF, #A78BFA); }
  .arena-score { margin-left: auto; display: flex; align-items: baseline; gap: 8px; color: #F5A623; font: 700 .62rem/1 'Space Mono', monospace; }
  .arena-score strong { color: #F5F5F5; font-size: 1.3rem; letter-spacing: .08em; }
  .arena-center-status { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 3; color: rgba(225,236,255,.85); font: 700 .72rem/1.4 'Space Mono', monospace; letter-spacing: .06em; text-align: center; text-transform: uppercase; text-shadow: 0 0 18px rgba(0,229,255,.6); pointer-events: none; }
  .arena-abilities { display: flex; gap: 7px; }
  .arena-ability, .arena-launch { border: 1px solid rgba(91,106,148,.7); border-radius: 9px; background: rgba(9,15,28,.82); color: #CBD7EE; cursor: pointer; font-family: inherit; transition: transform .18s, border-color .18s, background .18s, color .18s; }
  .arena-ability { display: grid; grid-template-columns: 22px auto; grid-template-rows: 1fr 1fr; min-width: 116px; padding: 7px 8px; text-align: left; }
  .arena-ability b { grid-row: 1 / 3; align-self: center; color: #F5A623; font: 900 .88rem/1 'Space Mono', monospace; }
  .arena-ability span { font-size: .66rem; font-weight: 700; white-space: nowrap; }
  .arena-ability small { color: #68758E; font: 600 .56rem/1 'Space Mono', monospace; }
  .arena-ability:hover:not(:disabled), .arena-launch:hover { transform: translateY(-2px); border-color: #00E5FF; color: #F5F5F5; background: rgba(0,229,255,.1); }
  .arena-ability:disabled { cursor: not-allowed; opacity: .42; }
  .arena-launch { padding: 12px 15px; border-color: #F5A623; background: #F5A623; color: #0D0D0D; font-size: .75rem; font-weight: 800; white-space: nowrap; }
  .arena-launch:hover { border-color: #FCD068; background: #FCD068; }
  .arena-brief { padding: 24px; border: 1px solid rgba(55,67,98,.7); border-radius: 18px; background: linear-gradient(145deg, rgba(18,23,36,.98), rgba(11,15,26,.98)); }
  .arena-brief h3 { margin: 12px 0 10px; color: #F5F5F5; font-size: 1.25rem; letter-spacing: -.04em; }
  .arena-brief p { margin: 0; color: #8992A8; font-size: .78rem; line-height: 1.65; }
  .arena-objectives { margin: 24px 0; border-top: 1px solid rgba(55,67,98,.45); border-bottom: 1px solid rgba(55,67,98,.45); }
  .arena-objectives div { display: grid; grid-template-columns: 10px 1fr auto; align-items: center; gap: 9px; padding: 12px 0; color: #B8C5DC; font-size: .72rem; }
  .arena-objectives strong { color: #F5A623; font: 700 .7rem/1 'Space Mono', monospace; }
  .objective-dot { width: 7px; height: 7px; border-radius: 50%; box-shadow: 0 0 12px currentColor; }
  .objective-dot.cyan { color: #00E5FF; background: #00E5FF; }
  .objective-dot.amber { color: #F5A623; background: #F5A623; }
  .objective-dot.violet { color: #A78BFA; background: #A78BFA; }
  .arena-hint { margin-top: 20px !important; padding: 10px 12px; border-left: 2px solid #F5A623; background: rgba(245,166,35,.05); color: #A5B1C8 !important; font-size: .7rem !important; }
  @media (max-width: 980px) { .arena-shell { grid-template-columns: 1fr; } .arena-brief { display: grid; grid-template-columns: 1fr 1fr; gap: 0 24px; } .arena-brief h3, .arena-brief-label, .arena-brief > p { grid-column: 1; } .arena-objectives { grid-column: 2; grid-row: 1 / 4; margin: 0; } .arena-hint { grid-column: 1 / -1; } }
  @media (max-width: 650px) { .arena-section-head { display: block; } .arena-shortcut { margin-top: 12px; text-align: left; } .arena-visual { min-height: 540px; } .arena-hud { left: 12px; right: 12px; } .arena-hud-top { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; } .arena-score { grid-column: 1 / -1; margin: 2px 0 0; } .arena-stat { grid-template-columns: auto minmax(70px, 1fr) auto; } .arena-hud-bottom { display: block; } .arena-abilities { display: grid; grid-template-columns: 1fr 1fr 1fr; } .arena-ability { min-width: 0; padding: 6px; } .arena-ability span { overflow: hidden; text-overflow: ellipsis; } .arena-launch { width: 100%; margin-top: 9px; } .arena-brief { display: block; } .arena-objectives { margin: 22px 0; } }
  @media (prefers-reduced-motion: reduce) { .arena-visual *, .arena-ability, .arena-launch { transition: none !important; } }
</style>

<script>
  const arenaRoot = document.querySelector<HTMLElement>('[data-stormblade-arena]');
  const arena = document.getElementById('stormblade-arena');
  const canvas = document.getElementById('stormblade-canvas') as HTMLCanvasElement | null;
  const context = canvas?.getContext('2d');
  const launchButton = document.getElementById('arena-launch') as HTMLButtonElement | null;
  const statusElement = document.getElementById('arena-status');
  const healthBar = document.getElementById('arena-health-bar');
  const energyBar = document.getElementById('arena-energy-bar');
  const healthValue = document.getElementById('arena-health-value');
  const energyValue = document.getElementById('arena-energy-value');
  const scoreValue = document.getElementById('arena-score-value');
  const defeatedValue = document.getElementById('arena-defeated-value');
  const bestValue = document.getElementById('arena-best-value');
  const abilityButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.arena-ability'));
  const demoMode = new URLSearchParams(window.location.search).has('demo');
  const lowPowerDevice = window.matchMedia('(pointer: coarse)').matches || (navigator.hardwareConcurrency || 8) <= 4;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (arenaRoot && arena && canvas && context && launchButton) {
    type Vec2 = { x: number; y: number };
    type Enemy = { x: number; y: number; radius: number; speed: number; phase: number; hp: number };
    type Bolt = { x: number; y: number; vx: number; vy: number; life: number; power: number };
    type Effect = { x: number; y: number; radius: number; life: number; maxLife: number; color: string; kind: 'ring' | 'bolt' };
    const keys = new Set<string>();
    const player: Vec2 & { health: number; energy: number; dash: number } = { x: 0, y: 0, health: 100, energy: 100, dash: 0 };
    const enemies: Enemy[] = [];
    const bolts: Bolt[] = [];
    const effects: Effect[] = [];
    const stars = Array.from({ length: lowPowerDevice ? 22 : 44 }, (_, index) => ({ x: (index * 83) % 1000, y: (index * 47) % 500, r: 0.5 + (index % 3) * 0.35, phase: index * 1.7 }));
    let width = 0;
    let height = 0;
    let scale = 1;
    let running = false;
    let frame = 0;
    let lastTime = 0;
    let spawnTimer = 0;
    let score = 0;
    let defeated = 0;
    let best = Number(localStorage.getItem('cosmic-stormblade-best') || 0);
    let wave = 1;
    let lastAbility = 0;
    let pointerTarget: Vec2 | null = null;
    let demoTime = 0;
    let demoFinished = false;
    let isVisible = true;

    if (bestValue) bestValue.textContent = String(best).padStart(2, '0');

    const resize = () => {
      const rect = arena.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      scale = Math.min(window.devicePixelRatio || 1, lowPowerDevice ? 1 : 1.25);
      canvas.width = Math.floor(width * scale);
      canvas.height = Math.floor(height * scale);
      context.setTransform(scale, 0, 0, scale, 0, 0);
      if (!running) player.x = width / 2;
      if (!running) player.y = height / 2;
    };

    const updateHud = () => {
      if (healthBar) healthBar.style.width = `${Math.max(0, player.health)}%`;
      if (energyBar) energyBar.style.width = `${Math.max(0, player.energy)}%`;
      if (healthValue) healthValue.textContent = String(Math.round(player.health));
      if (energyValue) energyValue.textContent = String(Math.round(player.energy));
      if (scoreValue) scoreValue.textContent = String(score).padStart(2, '0');
      if (defeatedValue) defeatedValue.textContent = String(defeated).padStart(2, '0');
      abilityButtons.forEach((button) => {
        const cost = Number(button.querySelector('small')?.textContent.match(/\d+/)?.[0] || 0);
        button.disabled = !running || player.energy < cost;
      });
    };

    const setStatus = (message: string) => { if (statusElement) statusElement.textContent = message; };

    const spawnEnemy = () => {
      const edge = Math.floor(Math.random() * 4);
      const padding = 30;
      const x = edge === 0 ? padding : edge === 1 ? width - padding : Math.random() * width;
      const y = edge === 2 ? padding : edge === 3 ? height - padding : Math.random() * height;
      enemies.push({ x, y, radius: 10 + Math.random() * 4, speed: 18 + wave * 2 + Math.random() * 12, phase: Math.random() * Math.PI * 2, hp: 1 });
    };

    const resetGame = () => {
      enemies.length = 0; bolts.length = 0; effects.length = 0;
      player.x = width / 2; player.y = height / 2; player.health = 100; player.energy = 100; player.dash = 0;
      score = 0; defeated = 0; wave = 1; spawnTimer = 0; demoTime = 0; demoFinished = false;
      updateHud();
    };

    const defeat = () => {
      running = false;
      demoFinished = true;
      if (score > best) { best = score; localStorage.setItem('cosmic-stormblade-best', String(best)); }
      if (bestValue) bestValue.textContent = String(best).padStart(2, '0');
      launchButton.textContent = 'Retry trial';
      setStatus(`Trial ended · ${score} wraith${score === 1 ? '' : 's'} defeated`);
      updateHud();
    };

    const hurt = (amount: number) => {
      player.health = Math.max(0, player.health - amount);
      effects.push({ x: player.x, y: player.y, radius: 12, life: .28, maxLife: .28, color: '#EF476F', kind: 'ring' });
      if (player.health <= 0) defeat();
    };

    const nearestEnemy = () => enemies.reduce<Enemy | null>((nearest, enemy) => {
      if (!nearest) return enemy;
      return Math.hypot(enemy.x - player.x, enemy.y - player.y) < Math.hypot(nearest.x - player.x, nearest.y - player.y) ? enemy : nearest;
    }, null);

    const cast = (ability: string) => {
      if (!running) return;
      const now = performance.now();
      if (now - lastAbility < 180) return;
      const costs: Record<string, number> = { dash: 25, arc: 35, pulse: 50 };
      const cost = costs[ability] || 0;
      if (player.energy < cost) return;
      player.energy -= cost;
      lastAbility = now;
      if (ability === 'dash') {
        const target = pointerTarget || { x: player.x + (keys.has('a') || keys.has('arrowleft') ? -1 : 1) * 180, y: player.y };
        const length = Math.max(1, Math.hypot(target.x - player.x, target.y - player.y));
        player.x = Math.max(24, Math.min(width - 24, player.x + ((target.x - player.x) / length) * 120));
        player.y = Math.max(24, Math.min(height - 24, player.y + ((target.y - player.y) / length) * 120));
        player.dash = .24;
        effects.push({ x: player.x, y: player.y, radius: 18, life: .35, maxLife: .35, color: '#00E5FF', kind: 'bolt' });
        setStatus('Thunder Dash · repositioned');
      } else if (ability === 'arc') {
        const target = nearestEnemy();
        if (target) {
          bolts.push({ x: player.x, y: player.y, vx: (target.x - player.x) * 5, vy: (target.y - player.y) * 5, life: .28, power: 1 });
          effects.push({ x: target.x, y: target.y, radius: 30, life: .42, maxLife: .42, color: '#F5A623', kind: 'bolt' });
        }
        setStatus('Lightning Arc · target locked');
      } else {
        const radius = 105;
        enemies.forEach((enemy) => { if (Math.hypot(enemy.x - player.x, enemy.y - player.y) < radius) enemy.hp = 0; });
        effects.push({ x: player.x, y: player.y, radius, life: .5, maxLife: .5, color: '#A78BFA', kind: 'ring' });
        setStatus('Storm Pulse · field cleared');
      }
      updateHud();
    };

    const start = () => {
      resetGame();
      running = true;
      launchButton.textContent = 'Restart trial';
      setStatus('Trial live · break the arc-wraiths');
      for (let index = 0; index < 3; index += 1) spawnEnemy();
      updateHud();
      if (!frame && isVisible) frame = requestAnimationFrame(loop);
    };

    const update = (delta: number, time: number) => {
      if (!running) return;
      demoTime += delta;
      const moveX = (keys.has('d') || keys.has('arrowright') ? 1 : 0) - (keys.has('a') || keys.has('arrowleft') ? 1 : 0);
      const moveY = (keys.has('s') || keys.has('arrowdown') ? 1 : 0) - (keys.has('w') || keys.has('arrowup') ? 1 : 0);
      const demoX = demoMode ? Math.cos(demoTime * .0012) : 0;
      const demoY = demoMode ? Math.sin(demoTime * .0012) : 0;
      player.x = Math.max(20, Math.min(width - 20, player.x + (moveX + demoX) * 140 * delta));
      player.y = Math.max(20, Math.min(height - 20, player.y + (moveY + demoY) * 140 * delta));
      player.energy = Math.min(100, player.energy + delta * 7);
      player.dash = Math.max(0, player.dash - delta);
      spawnTimer -= delta;
      if (spawnTimer <= 0) { spawnEnemy(); spawnTimer = Math.max(.42, 1.15 - wave * .05); }
      if (score > 0 && score % 10 === 0) wave = Math.min(9, 1 + Math.floor(score / 10));

      enemies.forEach((enemy) => {
        const distance = Math.hypot(player.x - enemy.x, player.y - enemy.y) || 1;
        enemy.x += ((player.x - enemy.x) / distance) * enemy.speed * delta;
        enemy.y += ((player.y - enemy.y) / distance) * enemy.speed * delta;
        enemy.phase += delta * 4;
        if (distance < enemy.radius + 15) { enemy.hp = 0; hurt(8); }
      });
      bolts.forEach((bolt) => {
        bolt.x += bolt.vx * delta; bolt.y += bolt.vy * delta; bolt.life -= delta;
        enemies.forEach((enemy) => { if (enemy.hp > 0 && Math.hypot(bolt.x - enemy.x, bolt.y - enemy.y) < enemy.radius + 14) enemy.hp = 0; });
      });
      enemies.forEach((enemy) => { if (enemy.hp <= 0) { score += 1; defeated += 1; player.energy = Math.min(100, player.energy + 4); effects.push({ x: enemy.x, y: enemy.y, radius: 22, life: .35, maxLife: .35, color: '#F5A623', kind: 'ring' }); } });
      enemies.splice(0, enemies.length, ...enemies.filter((enemy) => enemy.hp > 0));
      bolts.splice(0, bolts.length, ...bolts.filter((bolt) => bolt.life > 0));
      effects.forEach((effect) => { effect.life -= delta; });
      effects.splice(0, effects.length, ...effects.filter((effect) => effect.life > 0));
      if (demoMode && Math.floor(demoTime / 1600) !== Math.floor((demoTime - delta) / 1600)) cast(['dash', 'arc', 'pulse'][Math.floor(demoTime / 1600) % 3]);
      updateHud();
      void time;
    };

    const drawLightning = (x: number, y: number, length: number, color: string, alpha = 1) => {
      context.save();
      context.strokeStyle = color;
      context.globalAlpha = alpha;
      context.shadowColor = color;
      context.shadowBlur = lowPowerDevice ? 8 : 16;
      context.lineWidth = 2;
      context.beginPath();
      context.moveTo(x, y);
      for (let index = 1; index <= 5; index += 1) context.lineTo(x + length * index / 5, y + Math.sin(index * 5.4) * 9);
      context.stroke();
      context.restore();
    };

    const draw = (time: number) => {
      context.clearRect(0, 0, width, height);
      const gradient = context.createRadialGradient(width * .72, height * .35, 10, width * .72, height * .35, width * .75);
      gradient.addColorStop(0, 'rgba(0,229,255,.12)'); gradient.addColorStop(1, 'rgba(7,10,20,0)');
      context.fillStyle = gradient; context.fillRect(0, 0, width, height);
      stars.forEach((star) => { context.fillStyle = `rgba(150,220,255,${.18 + Math.sin(time * .002 + star.phase) * .12})`; context.beginPath(); context.arc((star.x / 1000) * width, (star.y / 500) * height, star.r, 0, Math.PI * 2); context.fill(); });
      enemies.forEach((enemy) => {
        const pulse = Math.sin(enemy.phase) * 2;
        context.save(); context.shadowColor = '#D14EFF'; context.shadowBlur = 18;
        context.fillStyle = '#40195E'; context.strokeStyle = '#D14EFF'; context.lineWidth = 1.5;
        context.beginPath(); context.arc(enemy.x, enemy.y, enemy.radius + pulse, 0, Math.PI * 2); context.fill(); context.stroke();
        context.fillStyle = '#F0A6FF'; context.beginPath(); context.arc(enemy.x - 3, enemy.y - 3, 2, 0, Math.PI * 2); context.fill(); context.restore();
      });
      bolts.forEach((bolt) => drawLightning(bolt.x - bolt.vx * .03, bolt.y - bolt.vy * .03, 28, '#F5A623', Math.max(0, bolt.life * 3)));
      effects.forEach((effect) => { const progress = 1 - effect.life / effect.maxLife; context.save(); context.globalAlpha = Math.max(0, effect.life / effect.maxLife); context.strokeStyle = effect.color; context.shadowColor = effect.color; context.shadowBlur = 22; context.lineWidth = 2.5; context.beginPath(); context.arc(effect.x, effect.y, effect.kind === 'ring' ? effect.radius * progress : effect.radius * (1 + progress), 0, Math.PI * 2); context.stroke(); context.restore(); });
      context.save(); context.translate(player.x, player.y); context.rotate(-.35); context.shadowColor = '#00E5FF'; context.shadowBlur = 22; context.fillStyle = '#101C36'; context.strokeStyle = '#00E5FF'; context.lineWidth = 2; context.beginPath(); context.moveTo(-13, -12); context.lineTo(10, -16); context.lineTo(17, 0); context.lineTo(8, 14); context.lineTo(-12, 11); context.closePath(); context.fill(); context.stroke(); context.fillStyle = '#F5C45F'; context.beginPath(); context.arc(0, -4, 4, 0, Math.PI * 2); context.fill(); drawLightning(10, 3, 38, '#00E5FF'); context.restore();
    };

    const loop = (time: number) => {
      frame = 0;
      const delta = Math.min(.05, Math.max(.001, (time - lastTime) / 1000 || .016));
      lastTime = time;
      update(delta, time); draw(time);
      if (isVisible && (running || (demoMode && !demoFinished && demoTime < 12000))) frame = requestAnimationFrame(loop);
    };

    const pointerMove = (event: PointerEvent) => { const rect = arena.getBoundingClientRect(); pointerTarget = { x: event.clientX - rect.left, y: event.clientY - rect.top }; };
    arena.addEventListener('pointermove', pointerMove, { passive: true });
    arena.addEventListener('pointerleave', () => { pointerTarget = null; }, { passive: true });
    window.addEventListener('keydown', (event) => { const key = event.key.toLowerCase(); if (['w','a','s','d','arrowup','arrowdown','arrowleft','arrowright'].includes(key)) { event.preventDefault(); keys.add(key); } if (key === '1') cast('dash'); if (key === '2') cast('arc'); if (key === '3') cast('pulse'); });
    window.addEventListener('keyup', (event) => keys.delete(event.key.toLowerCase()));
    const arenaObserver = new IntersectionObserver(([entry]) => {
      isVisible = Boolean(entry?.isIntersecting);
      if (isVisible && (running || (demoMode && !demoFinished)) && !frame) frame = requestAnimationFrame(loop);
    }, { threshold: 0.05 });
    arenaObserver.observe(arena);
    window.addEventListener('resize', resize, { passive: true });
    launchButton.addEventListener('click', start);
    abilityButtons.forEach((button) => button.addEventListener('click', () => cast(button.dataset.ability || '')));
    window.addEventListener('beforeunload', () => arenaObserver.disconnect(), { once: true });
    resize(); draw(0); updateHud();
    if (demoMode && !reducedMotion) start();
  }
</script>
