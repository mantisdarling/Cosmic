<section class="frost-section" aria-labelledby="frost-heading">
  <div class="frost-head">
    <div>
      <div class="frost-kicker">Training simulation // 003</div>
      <h2 id="frost-heading">Frostwarden: Frostbound Circuit</h2>
      <p>Route the crystal core through the frozen grid, collect every sigil, and keep the circuit from thawing.</p>
    </div>
    <div class="frost-shortcut">WASD / arrows to route · 1 2 3 to cast</div>
  </div>

  <div class="frost-roster" aria-label="Playable character roster">
    <a class="frost-roster-card storm" href="#stormblade-arena">
      <span class="frost-roster-index">01</span><span><strong>Stormblade</strong><small>Lightning duelist · live above</small></span><span class="frost-roster-arrow">↗</span>
    </a>
    <button class="frost-roster-card frost active" type="button" aria-current="true">
      <span class="frost-roster-index">02</span><span><strong>Frostwarden</strong><small>Ice tactician · playable now</small></span><span class="frost-roster-arrow">✦</span>
    </button>
  </div>

  <div class="frost-shell" data-frostbound-circuit>
    <div class="frost-visual" id="frostbound-arena" tabindex="0" role="application" aria-label="Frostwarden Frostbound Circuit mini-game">
      <canvas id="frostbound-canvas"></canvas>
      <div class="frost-scanlines" aria-hidden="true"></div>
      <div class="frost-hud frost-hud-top">
        <div class="frost-stat"><span>STABILITY</span><div class="frost-meter"><i id="frost-stability-bar"></i></div><strong id="frost-stability-value">100</strong></div>
        <div class="frost-stat"><span>FOCUS</span><div class="frost-meter focus"><i id="frost-focus-bar"></i></div><strong id="frost-focus-value">100</strong></div>
        <div class="frost-score"><span>SIGILS</span><strong id="frost-sigil-value">00 / 05</strong></div>
      </div>
      <div class="frost-status" id="frost-status" role="status">Press launch to map the circuit</div>
      <div class="frost-hud frost-hud-bottom">
        <div class="frost-abilities" aria-label="Frostwarden abilities">
          <button type="button" class="frost-ability" data-frost-ability="step" aria-label="Cast Glacier Step, keyboard 1"><b>1</b><span>Glacier Step</span><small>20 FC</small></button>
          <button type="button" class="frost-ability" data-frost-ability="lock" aria-label="Cast Glacial Lock, keyboard 2"><b>2</b><span>Glacial Lock</span><small>30 FC</small></button>
          <button type="button" class="frost-ability" data-frost-ability="bloom" aria-label="Cast Aurora Bloom, keyboard 3"><b>3</b><span>Aurora Bloom</span><small>45 FC</small></button>
        </div>
        <button type="button" class="frost-launch" id="frost-launch">Launch circuit</button>
      </div>
    </div>
    <aside class="frost-brief" aria-label="Frostwarden circuit instructions">
      <div class="frost-brief-label">Mission brief</div>
      <h3>Route the crystal core.</h3>
      <p>Move across the grid and collect five sigils before stability reaches zero. Ice abilities bend the route, freeze hazards, and harvest nearby nodes.</p>
      <div class="frost-objectives">
        <div><span class="frost-dot cyan"></span><span>Sigils collected</span><strong id="frost-collected-value">00</strong></div>
        <div><span class="frost-dot violet"></span><span>Hazards frozen</span><strong id="frost-frozen-value">00</strong></div>
        <div><span class="frost-dot amber"></span><span>Best circuit</span><strong id="frost-best-value">00</strong></div>
      </div>
      <p class="frost-hint">Tip: Glacial Lock buys time. Aurora Bloom collects nearby sigils without moving.</p>
    </aside>
  </div>
</section>

<style>
  .frost-section { max-width: 1200px; margin: 0 auto; padding: 8px 24px 60px; }
  .frost-head { display:flex; align-items:end; justify-content:space-between; gap:20px; margin-bottom:16px; }
  .frost-head h2 { margin:8px 0; color:#F5F5F5; font-size:clamp(1.35rem,2.5vw,2rem); letter-spacing:-.045em; }
  .frost-head p { max-width:640px; margin:0; color:#8992A8; font-size:.82rem; line-height:1.6; }
  .frost-kicker,.frost-brief-label { color:#9EEBFF; font:700 .66rem/1 'Space Mono',monospace; letter-spacing:.1em; text-transform:uppercase; }
  .frost-shortcut { color:#69758E; font:600 .64rem/1.4 'Space Mono',monospace; text-align:right; text-transform:uppercase; }
  .frost-roster { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; margin-bottom:12px; }
  .frost-roster-card { display:grid; grid-template-columns:auto 1fr auto; align-items:center; gap:12px; min-height:66px; padding:11px 14px; border:1px solid rgba(55,67,98,.7); border-radius:12px; background:linear-gradient(110deg,rgba(16,22,38,.96),rgba(9,14,25,.92)); color:#C7D4E9; text-align:left; text-decoration:none; cursor:pointer; }
  .frost-roster-card:hover,.frost-roster-card:focus-visible { border-color:#00E5FF; outline:none; }
  .frost-roster-card.active { border-color:rgba(142,235,255,.7); box-shadow:inset 3px 0 #9EEBFF,0 12px 28px rgba(0,0,0,.18); }
  .frost-roster-card.storm { box-shadow:inset 3px 0 #F5A623; }
  .frost-roster-index { color:#71809B; font:700 .66rem/1 'Space Mono',monospace; }
  .frost-roster-card strong { display:block; color:#F5F5F5; font-size:.82rem; }
  .frost-roster-card small { display:block; margin-top:4px; color:#73819A; font-size:.66rem; }
  .frost-roster-arrow { color:#9EEBFF; font-size:1.1rem; }
  .frost-shell { display:grid; grid-template-columns:minmax(0,1.55fr) minmax(240px,.45fr); gap:12px; }
  .frost-visual { position:relative; min-height:450px; overflow:hidden; border:1px solid rgba(142,235,255,.32); border-radius:18px; background:linear-gradient(90deg,rgba(4,10,24,.97),rgba(8,13,30,.6)),url('/cosmic-frostwarden.png') center right/cover; box-shadow:0 22px 60px rgba(0,0,0,.36),inset 0 0 70px rgba(142,235,255,.1); outline:none; }
  .frost-visual:focus-visible { box-shadow:0 0 0 3px rgba(158,235,255,.3),0 22px 60px rgba(0,0,0,.36); }
  #frostbound-canvas { position:absolute; inset:0; display:block; width:100%; height:100%; }
  .frost-scanlines { position:absolute; inset:0; pointer-events:none; background:linear-gradient(rgba(142,235,255,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(142,235,255,.03) 1px,transparent 1px); background-size:38px 38px; mask-image:linear-gradient(180deg,transparent,#000 30%,#000 78%,transparent); }
  .frost-hud { position:absolute; left:20px; right:20px; z-index:3; display:flex; align-items:center; gap:18px; pointer-events:none; }
  .frost-hud-top { top:18px; }
  .frost-hud-bottom { bottom:18px; justify-content:space-between; align-items:end; pointer-events:auto; }
  .frost-stat { display:grid; grid-template-columns:auto minmax(100px,190px) auto; align-items:center; gap:8px; color:#A8B0C2; font:700 .62rem/1 'Space Mono',monospace; }
  .frost-stat strong { color:#F5F5F5; font-size:.7rem; }
  .frost-meter { height:6px; overflow:hidden; border-radius:99px; background:rgba(255,255,255,.12); }
  .frost-meter i { display:block; width:100%; height:100%; border-radius:inherit; background:linear-gradient(90deg,#4BC0FF,#9EEBFF); transition:width .2s; }
  .frost-meter.focus i { background:linear-gradient(90deg,#A78BFA,#E0D5FF); }
  .frost-score { margin-left:auto; display:flex; align-items:baseline; gap:8px; color:#9EEBFF; font:700 .62rem/1 'Space Mono',monospace; }
  .frost-score strong { color:#F5F5F5; font-size:1.05rem; letter-spacing:.08em; }
  .frost-status { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); z-index:3; color:rgba(225,244,255,.86); font:700 .72rem/1.4 'Space Mono',monospace; letter-spacing:.06em; text-align:center; text-transform:uppercase; text-shadow:0 0 18px rgba(142,235,255,.7); pointer-events:none; }
  .frost-abilities { display:flex; gap:7px; }
  .frost-ability,.frost-launch { border:1px solid rgba(91,106,148,.7); border-radius:9px; background:rgba(9,15,28,.86); color:#CBD7EE; cursor:pointer; font-family:inherit; transition:transform .18s,border-color .18s,background .18s,color .18s; }
  .frost-ability { display:grid; grid-template-columns:22px auto; grid-template-rows:1fr 1fr; min-width:116px; padding:7px 8px; text-align:left; }
  .frost-ability b { grid-row:1/3; align-self:center; color:#9EEBFF; font:900 .88rem/1 'Space Mono',monospace; }
  .frost-ability span { font-size:.66rem; font-weight:700; white-space:nowrap; }
  .frost-ability small { color:#68758E; font:600 .56rem/1 'Space Mono',monospace; }
  .frost-ability:hover:not(:disabled),.frost-launch:hover { transform:translateY(-2px); border-color:#9EEBFF; color:#F5F5F5; background:rgba(142,235,255,.1); }
  .frost-ability:disabled { cursor:not-allowed; opacity:.42; }
  .frost-launch { padding:12px 15px; border-color:#9EEBFF; background:#9EEBFF; color:#08101C; font-size:.75rem; font-weight:800; white-space:nowrap; }
  .frost-launch:hover { border-color:#DDF9FF; background:#DDF9FF; }
  .frost-brief { padding:24px; border:1px solid rgba(55,67,98,.7); border-radius:18px; background:linear-gradient(145deg,rgba(18,23,36,.98),rgba(11,15,26,.98)); }
  .frost-brief h3 { margin:12px 0 10px; color:#F5F5F5; font-size:1.25rem; letter-spacing:-.04em; }
  .frost-brief p { margin:0; color:#8992A8; font-size:.78rem; line-height:1.65; }
  .frost-objectives { margin:24px 0; border-top:1px solid rgba(55,67,98,.45); border-bottom:1px solid rgba(55,67,98,.45); }
  .frost-objectives div { display:grid; grid-template-columns:10px 1fr auto; align-items:center; gap:9px; padding:12px 0; color:#B8C5DC; font-size:.72rem; }
  .frost-objectives strong { color:#9EEBFF; font:700 .7rem/1 'Space Mono',monospace; }
  .frost-dot { width:7px; height:7px; border-radius:50%; box-shadow:0 0 12px currentColor; }
  .frost-dot.cyan { color:#9EEBFF; background:#9EEBFF; }.frost-dot.violet { color:#A78BFA; background:#A78BFA; }.frost-dot.amber { color:#F5A623; background:#F5A623; }
  .frost-hint { margin-top:20px!important; padding:10px 12px; border-left:2px solid #9EEBFF; background:rgba(142,235,255,.05); color:#A5B1C8!important; font-size:.7rem!important; }
  @media(max-width:980px){.frost-shell{grid-template-columns:1fr}.frost-brief{display:grid;grid-template-columns:1fr 1fr;gap:0 24px}.frost-brief h3,.frost-brief-label,.frost-brief>p{grid-column:1}.frost-objectives{grid-column:2;grid-row:1/4;margin:0}.frost-hint{grid-column:1/-1}}
  @media(max-width:650px){.frost-head{display:block}.frost-shortcut{margin-top:12px;text-align:left}.frost-roster{grid-template-columns:1fr}.frost-visual{min-height:540px}.frost-hud{left:12px;right:12px}.frost-hud-top{display:grid;grid-template-columns:1fr 1fr;gap:8px}.frost-score{grid-column:1/-1;margin:2px 0 0}.frost-stat{grid-template-columns:auto minmax(70px,1fr) auto}.frost-hud-bottom{display:block}.frost-abilities{display:grid;grid-template-columns:1fr 1fr 1fr}.frost-ability{min-width:0;padding:6px}.frost-ability span{overflow:hidden;text-overflow:ellipsis}.frost-launch{width:100%;margin-top:9px}.frost-brief{display:block}.frost-objectives{margin:22px 0}}
  @media(prefers-reduced-motion:reduce){.frost-visual *,.frost-ability,.frost-launch{transition:none!important}}
</style>

<script>
  const frostRoot = document.querySelector<HTMLElement>('[data-frostbound-circuit]');
  const frostArena = document.getElementById('frostbound-arena');
  const frostCanvas = document.getElementById('frostbound-canvas') as HTMLCanvasElement | null;
  const frostContext = frostCanvas?.getContext('2d');
  const frostLaunch = document.getElementById('frost-launch') as HTMLButtonElement | null;
  const frostStatus = document.getElementById('frost-status');
  const frostStabilityBar = document.getElementById('frost-stability-bar');
  const frostFocusBar = document.getElementById('frost-focus-bar');
  const frostStabilityValue = document.getElementById('frost-stability-value');
  const frostFocusValue = document.getElementById('frost-focus-value');
  const frostSigilValue = document.getElementById('frost-sigil-value');
  const frostCollectedValue = document.getElementById('frost-collected-value');
  const frostFrozenValue = document.getElementById('frost-frozen-value');
  const frostBestValue = document.getElementById('frost-best-value');
  const frostAbilityButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.frost-ability'));
  const frostDemo = new URLSearchParams(window.location.search).has('demo');

  if (frostRoot && frostArena && frostCanvas && frostContext && frostLaunch) {
    type Cell = { x: number; y: number };
    type Hazard = Cell & { phase: number };
    type Spark = Cell & { life: number; color: string };
    const cols = 8;
    const rows = 5;
    const player: Cell & { stability: number; focus: number } = { x: 1, y: 3, stability: 100, focus: 100 };
    const sigils: Cell[] = [];
    const hazards: Hazard[] = [];
    const sparks: Spark[] = [];
    const pressed = new Set<string>();
    let width = 0;
    let height = 0;
    let scale = 1;
    let cellSize = 0;
    let offsetX = 0;
    let offsetY = 0;
    let running = false;
    let frozenUntil = 0;
    let frozenCount = 0;
    let collected = 0;
    let best = Number(localStorage.getItem('cosmic-frostbound-best') || 0);
    let lastTime = 0;
    let frame = 0;
    let demoTime = 0;

    if (frostBestValue) frostBestValue.textContent = String(best).padStart(2, '0');

    const resize = () => {
      const rect = frostArena.getBoundingClientRect();
      width = rect.width; height = rect.height; scale = Math.min(window.devicePixelRatio || 1, 1.5);
      frostCanvas.width = Math.floor(width * scale); frostCanvas.height = Math.floor(height * scale); frostContext.setTransform(scale, 0, 0, scale, 0, 0);
      cellSize = Math.min((width - 80) / cols, (height - 150) / rows); offsetX = (width - cellSize * cols) / 2; offsetY = (height - cellSize * rows) / 2;
    };

    const status = (message: string) => { if (frostStatus) frostStatus.textContent = message; };
    const updateHud = () => {
      if (frostStabilityBar) frostStabilityBar.style.width = `${Math.max(0, player.stability)}%`;
      if (frostFocusBar) frostFocusBar.style.width = `${Math.max(0, player.focus)}%`;
      if (frostStabilityValue) frostStabilityValue.textContent = String(Math.round(player.stability));
      if (frostFocusValue) frostFocusValue.textContent = String(Math.round(player.focus));
      if (frostSigilValue) frostSigilValue.textContent = `${String(collected).padStart(2, '0')} / 05`;
      if (frostCollectedValue) frostCollectedValue.textContent = String(collected).padStart(2, '0');
      if (frostFrozenValue) frostFrozenValue.textContent = String(frozenCount).padStart(2, '0');
      frostAbilityButtons.forEach((button) => { const cost = Number(button.querySelector('small')?.textContent.match(/\d+/)?.[0] || 0); button.disabled = !running || player.focus < cost; });
    };

    const addSpark = (cell: Cell, color: string) => sparks.push({ x: cell.x, y: cell.y, life: .5, color });
    const spawnLayout = () => {
      sigils.length = 0; hazards.length = 0; collected = 0; frozenCount = 0;
      const sigilSpots = [[6, 1], [2, 0], [4, 3], [7, 4], [3, 2]];
      sigilSpots.forEach(([x, y]) => sigils.push({ x, y }));
      [[4, 1], [5, 4], [1, 1], [6, 3]].forEach(([x, y], index) => hazards.push({ x, y, phase: index * 1.4 }));
    };
    const reset = () => { player.x = 1; player.y = 3; player.stability = 100; player.focus = 100; frozenUntil = 0; demoTime = 0; sparks.length = 0; spawnLayout(); updateHud(); };
    const finish = (success: boolean) => { running = false; if (success) { best = Math.max(best, collected); localStorage.setItem('cosmic-frostbound-best', String(best)); if (frostBestValue) frostBestValue.textContent = String(best).padStart(2, '0'); status('Circuit complete · aurora stabilized'); } else status('Circuit fractured · reroute and try again'); frostLaunch.textContent = 'Retry circuit'; updateHud(); };
    const collect = () => { for (let index = sigils.length - 1; index >= 0; index -= 1) { if (sigils[index].x === player.x && sigils[index].y === player.y) { sigils.splice(index, 1); collected += 1; player.focus = Math.min(100, player.focus + 12); addSpark(player, '#9EEBFF'); status(`Sigil ${collected} secured · circuit holding`); } } if (collected >= 5) finish(true); };
    const move = (dx: number, dy: number) => { if (!running) return; player.x = Math.max(0, Math.min(cols - 1, player.x + dx)); player.y = Math.max(0, Math.min(rows - 1, player.y + dy)); addSpark(player, '#9EEBFF'); collect(); };
    const cast = (ability: string) => {
      if (!running) return;
      const costs: Record<string, number> = { step: 20, lock: 30, bloom: 45 }; const cost = costs[ability] || 0; if (player.focus < cost) return; player.focus -= cost;
      if (ability === 'step') { const target = sigils[0] || { x: player.x + 1, y: player.y }; const dx = Math.sign(target.x - player.x); const dy = dx === 0 ? Math.sign(target.y - player.y) : 0; player.x = Math.max(0, Math.min(cols - 1, player.x + dx * 2)); player.y = Math.max(0, Math.min(rows - 1, player.y + dy * 2)); addSpark(player, '#E0D5FF'); collect(); status('Glacier Step · route rewritten'); }
      if (ability === 'lock') { frozenUntil = performance.now() + 3200; frozenCount += hazards.length; hazards.forEach((hazard) => addSpark(hazard, '#A78BFA')); status('Glacial Lock · hazards frozen'); }
      if (ability === 'bloom') { const nearby = sigils.filter((sigil) => Math.abs(sigil.x - player.x) <= 1 && Math.abs(sigil.y - player.y) <= 1); nearby.forEach((sigil) => { sigils.splice(sigils.indexOf(sigil), 1); collected += 1; addSpark(sigil, '#9EEBFF'); }); status('Aurora Bloom · nearby sigils harvested'); if (collected >= 5) finish(true); }
      updateHud();
    };
    const start = () => { reset(); running = true; frostLaunch.textContent = 'Restart circuit'; status('Circuit live · collect the sigils'); if (!frame) frame = requestAnimationFrame(loop); };
    const update = (delta: number, time: number) => {
      if (!running) return;
      player.focus = Math.min(100, player.focus + delta * 5);
      const frozen = time < frozenUntil;
      if (!frozen) hazards.forEach((hazard) => { hazard.phase += delta * 3; if (hazard.x === player.x && hazard.y === player.y && Math.sin(hazard.phase) > .2) { player.stability = Math.max(0, player.stability - delta * 18); addSpark(player, '#A78BFA'); } });
      sparks.forEach((spark) => { spark.life -= delta; }); sparks.splice(0, sparks.length, ...sparks.filter((spark) => spark.life > 0));
      if (player.stability <= 0) finish(false);
      if (frostDemo) { demoTime += delta; if (Math.floor(demoTime * 2) !== Math.floor((demoTime - delta) * 2)) { const target = sigils[0]; if (target) move(Math.sign(target.x - player.x), Math.sign(target.y - player.y)); } if (Math.floor(demoTime / 2.4) !== Math.floor((demoTime - delta) / 2.4)) cast(['step', 'lock', 'bloom'][Math.floor(demoTime / 2.4) % 3]); }
      updateHud();
    };
    const draw = (time: number) => {
      frostContext.clearRect(0, 0, width, height);
      const haze = frostContext.createRadialGradient(width * .28, height * .38, 8, width * .28, height * .38, width * .72); haze.addColorStop(0, 'rgba(158,235,255,.13)'); haze.addColorStop(1, 'rgba(5,11,26,0)'); frostContext.fillStyle = haze; frostContext.fillRect(0, 0, width, height);
      for (let y = 0; y < rows; y += 1) for (let x = 0; x < cols; x += 1) { const cx = offsetX + x * cellSize + cellSize / 2; const cy = offsetY + y * cellSize + cellSize / 2; frostContext.strokeStyle = 'rgba(158,235,255,.14)'; frostContext.lineWidth = 1; frostContext.strokeRect(offsetX + x * cellSize + 8, offsetY + y * cellSize + 8, cellSize - 16, cellSize - 16); frostContext.fillStyle = `rgba(158,235,255,${.12 + Math.sin(time * .002 + x + y) * .04})`; frostContext.beginPath(); frostContext.arc(cx, cy, 2, 0, Math.PI * 2); frostContext.fill(); }
      const frozen = performance.now() < frozenUntil;
      hazards.forEach((hazard) => { const cx = offsetX + hazard.x * cellSize + cellSize / 2; const cy = offsetY + hazard.y * cellSize + cellSize / 2; const pulse = frozen ? 0 : Math.sin(hazard.phase) * 4; frostContext.save(); frostContext.globalAlpha = frozen ? .45 : .8; frostContext.strokeStyle = frozen ? '#9EEBFF' : '#A78BFA'; frostContext.shadowColor = frostContext.strokeStyle; frostContext.shadowBlur = 15; frostContext.lineWidth = 2; frostContext.beginPath(); frostContext.arc(cx, cy, 13 + pulse, 0, Math.PI * 2); frostContext.stroke(); frostContext.restore(); });
      sigils.forEach((sigil) => { const cx = offsetX + sigil.x * cellSize + cellSize / 2; const cy = offsetY + sigil.y * cellSize + cellSize / 2; frostContext.save(); frostContext.translate(cx, cy); frostContext.rotate(time * .001); frostContext.fillStyle = '#9EEBFF'; frostContext.shadowColor = '#9EEBFF'; frostContext.shadowBlur = 18; frostContext.beginPath(); frostContext.moveTo(0, -10); frostContext.lineTo(8, 0); frostContext.lineTo(0, 10); frostContext.lineTo(-8, 0); frostContext.closePath(); frostContext.fill(); frostContext.restore(); });
      sparks.forEach((spark) => { const cx = offsetX + spark.x * cellSize + cellSize / 2; const cy = offsetY + spark.y * cellSize + cellSize / 2; frostContext.save(); frostContext.globalAlpha = spark.life * 2; frostContext.strokeStyle = spark.color; frostContext.shadowColor = spark.color; frostContext.shadowBlur = 22; frostContext.beginPath(); frostContext.arc(cx, cy, (1 - spark.life) * 28, 0, Math.PI * 2); frostContext.stroke(); frostContext.restore(); });
      const px = offsetX + player.x * cellSize + cellSize / 2; const py = offsetY + player.y * cellSize + cellSize / 2; frostContext.save(); frostContext.translate(px, py); frostContext.shadowColor = '#9EEBFF'; frostContext.shadowBlur = 26; frostContext.fillStyle = '#13284A'; frostContext.strokeStyle = '#DDF9FF'; frostContext.lineWidth = 2; frostContext.beginPath(); frostContext.moveTo(0, -15); frostContext.lineTo(13, 0); frostContext.lineTo(0, 15); frostContext.lineTo(-13, 0); frostContext.closePath(); frostContext.fill(); frostContext.stroke(); frostContext.fillStyle = '#9EEBFF'; frostContext.beginPath(); frostContext.arc(0, 0, 4, 0, Math.PI * 2); frostContext.fill(); frostContext.restore();
    };
    const loop = (time: number) => { frame = 0; const delta = Math.min(.05, Math.max(.001, (time - lastTime) / 1000 || .016)); lastTime = time; update(delta, time); draw(time); if (running || frostDemo) frame = requestAnimationFrame(loop); };
    frostArena.addEventListener('keydown', (event) => { const key = event.key.toLowerCase(); if (['w','a','s','d','arrowup','arrowdown','arrowleft','arrowright'].includes(key)) { event.preventDefault(); pressed.add(key); if (key === 'w' || key === 'arrowup') move(0, -1); if (key === 's' || key === 'arrowdown') move(0, 1); if (key === 'a' || key === 'arrowleft') move(-1, 0); if (key === 'd' || key === 'arrowright') move(1, 0); } if (key === '1') cast('step'); if (key === '2') cast('lock'); if (key === '3') cast('bloom'); });
    frostLaunch.addEventListener('click', start); frostAbilityButtons.forEach((button) => button.addEventListener('click', () => cast(button.dataset.frostAbility || ''))); window.addEventListener('resize', resize, { passive: true }); resize(); spawnLayout(); draw(0); updateHud(); if (frostDemo) start();
  }
