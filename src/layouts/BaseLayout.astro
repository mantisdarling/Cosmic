---
/**
 * BaseLayout.astro
 * Security hardening:
 *  - Strict Content-Security-Policy via <meta http-equiv>
 *  - X-Frame-Options equivalent (frameOptions) via Astro headers (configured in _headers)
 *  - Theme toggle uses localStorage with a strict whitelist ("dark"|"light") so injected
 *    values never reach setAttribute as arbitrary strings.
 *  - No innerHTML usage anywhere in this file.
 */
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Interactive learning roadmaps for Full Stack Web Development, AI Engineering, and more.',
  ogImage = '/og-default.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://cosmic-roadmap.pages.dev');
---

<!DOCTYPE html>
<html lang="en" data-theme="dark" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <meta name="author" content="Sehjal Saxena" />

  <!-- Security: Content-Security-Policy -->
  <!-- Allows: self, Google Fonts, Firebase (for auth), inline styles via nonce-less SHA -->
  <meta http-equiv="Content-Security-Policy" content="
    default-src 'self';
    script-src 'self' 'unsafe-inline' https://apis.google.com https://www.gstatic.com https://www.googleapis.com;
    style-src 'self' 'unsafe-inline' https://fonts.googleapis.com;
    font-src 'self' https://fonts.gstatic.com;
    img-src 'self' data: https:;
    connect-src 'self' https://*.googleapis.com https://*.google.com https://identitytoolkit.googleapis.com wss://*.firebaseio.com https://*.firebaseio.com;
    frame-src 'self' https://accounts.google.com;
    object-src 'none';
    base-uri 'self';
    form-action 'self';
    upgrade-insecure-requests;
  " />
  <!-- Security: prevent clickjacking -->
  <meta http-equiv="X-Frame-Options" content="DENY" />
  <!-- Security: prevent MIME-type sniffing -->
  <meta http-equiv="X-Content-Type-Options" content="nosniff" />
  <!-- Security: referrer policy -->
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <!-- Security: permissions policy (disable unused browser features) -->
  <meta http-equiv="Permissions-Policy" content="camera=(), microphone=(), geolocation=(), payment=()" />

  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={canonicalURL} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <title>{title}</title>

  <!-- Preconnect to external origins -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Grotesk:wght@300;400;500;600;700&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap"
    rel="stylesheet"
  />

  <!-- Global styles imported in frontmatter, processed by @tailwindcss/vite -->

  <!-- 
    SECURITY: Theme is persisted in localStorage and applied via a strict whitelist.
    We do NOT read from URL params or user-supplied strings.
    The script is intentionally inline and minimal — runs before paint to prevent flash.
  -->
  <script is:inline>
    (function () {
      const VALID_THEMES = ['dark', 'light'];
      const stored = localStorage.getItem('cosmic-theme');
      const theme = VALID_THEMES.includes(stored) ? stored : 'dark';
      document.documentElement.setAttribute('data-theme', theme);
      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
    })();
  </script>
</head>
<body>
  <slot />

  <!-- Scroll-reveal observer -->
  <script>
    // Show elements already in view immediately, animate the rest on scroll
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.05, rootMargin: '0px 0px -20px 0px' }
    );
    // Small delay so layout is complete before measuring
    requestAnimationFrame(() => {
      document.querySelectorAll('.rv').forEach((el) => observer.observe(el));
    });
  </script>
</body>
</html>
