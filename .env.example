# ─────────────────────────────────────────────────────────────
# .env.example — Cosmic Roadmap
# Copy this file to .env and fill in your Firebase values.
# DO NOT commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Firebase (client-side — prefixed PUBLIC_ so Astro exposes them to the browser)
# These values are NOT secrets — they identify your Firebase project.
# Your Firestore Security Rules (firestore.rules) are the real security layer.
# Without proper rules, these keys alone cannot read/write user data.

PUBLIC_FIREBASE_API_KEY=your-api-key-here
PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=your-project-id
PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# ─── IMPORTANT SECURITY NOTES ───────────────────────────────
# 1. Firebase API keys are safe to expose — they identify your project.
#    Your Firestore Security Rules control what authenticated users can do.
#    ALWAYS deploy the firestore.rules file to Firebase before going live.
#
# 2. Enable Firebase App Check in the Firebase Console for production.
#    This prevents API key abuse by verifying requests come from your app.
#
# 3. Set authorized domains in Firebase Console → Authentication → Settings.
#    Only add your actual domain(s) — not localhost in production.
#
# 4. Add these as environment variables in Cloudflare Pages:
#    Pages → Settings → Environment variables → Add variable
# ────────────────────────────────────────────────────────────
